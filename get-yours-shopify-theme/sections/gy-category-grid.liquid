<div class="gy-section gy-category-grid color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="gy-section__header">
      <div>
        {%- if section.settings.heading != blank -%}
          <h2 class="gy-section__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <div class="gy-section__subtitle rte">{{ section.settings.subtitle }}</div>
        {%- endif -%}
      </div>
      {%- if section.settings.view_all_label != blank and section.settings.view_all_link != blank -%}
        <a class="gy-link" href="{{ section.settings.view_all_link }}">{{ section.settings.view_all_label }}</a>
      {%- endif -%}
    </div>

    <div class="gy-category-grid__items">
      {%- for block in section.blocks -%}
        {%- assign category_link = block.settings.link -%}
        {%- if block.settings.collection != blank -%}
          {%- assign category_link = block.settings.collection.url -%}
        {%- endif -%}
        <a
          class="gy-category-card"
          {% if category_link != blank %}
            href="{{ category_link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <span class="gy-category-card__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'home' -%}HO
              {%- when 'desk' -%}OD
              {%- when 'kitchen' -%}KS
              {%- when 'lifestyle' -%}LS
              {%- when 'travel' -%}TR
              {%- when 'tech' -%}TA
              {%- else -%}GY
            {%- endcase -%}
          </span>
          <span class="gy-category-card__body">
            <span class="gy-category-card__title">{{ block.settings.title }}</span>
            {%- if block.settings.text != blank -%}
              <span class="gy-category-card__text">{{ block.settings.text }}</span>
            {%- endif -%}
            {%- if block.settings.badge != blank -%}
              <span class="gy-category-card__badge">{{ block.settings.badge }}</span>
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Get Yours category grid",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>Browse practical everyday finds by the way you use them.</p>"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "Browse all categories"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Home Organisation"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short text",
          "default": "Storage and tidy-home finds"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "home",
              "label": "Home"
            },
            {
              "value": "desk",
              "label": "Desk"
            },
            {
              "value": "kitchen",
              "label": "Kitchen"
            },
            {
              "value": "lifestyle",
              "label": "Lifestyle"
            },
            {
              "value": "travel",
              "label": "Travel"
            },
            {
              "value": "tech",
              "label": "Tech"
            }
          ],
          "default": "home"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Fallback link"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Get Yours category grid",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Home Organisation",
            "text": "Storage and tidy-home finds",
            "icon": "home"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Office & Desk",
            "text": "Work, study and desk upgrades",
            "icon": "desk"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Kitchen & Storage",
            "text": "Practical kitchen helpers",
            "icon": "kitchen"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Lifestyle",
            "text": "Everyday useful essentials",
            "icon": "lifestyle"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Travel",
            "text": "Compact carry and trip finds",
            "icon": "travel"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Tech Accessories",
            "text": "Simple add-ons for daily devices",
            "icon": "tech"
          }
        }
      ]
    }
  ]
}
{% endschema %}
