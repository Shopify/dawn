<div class="gy-section gy-trust-grid color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subtitle != blank -%}
      <div class="gy-section__header gy-section__header--center">
        <div>
          {%- if section.settings.heading != blank -%}
            <h2 class="gy-section__title">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.subtitle != blank -%}
            <div class="gy-section__subtitle rte">{{ section.settings.subtitle }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="gy-trust-grid__items">
      {%- for block in section.blocks -%}
        <article class="gy-trust-card" {{ block.shopify_attributes }}>
          <span class="gy-trust-card__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'delivery' -%}DL
              {%- when 'support' -%}SP
              {%- when 'secure' -%}SC
              {%- else -%}GY
            {%- endcase -%}
          </span>
          <div>
            {%- if block.settings.title != blank -%}
              <h3 class="gy-trust-card__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="gy-trust-card__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.link_label != blank and block.settings.link != blank -%}
              <a class="gy-link gy-trust-card__link" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Get Yours trust grid",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Delivery, support and checkout you can trust"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>Clear service details for everyday online shopping.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "delivery",
              "label": "Delivery"
            },
            {
              "value": "support",
              "label": "Support"
            },
            {
              "value": "secure",
              "label": "Secure"
            }
          ],
          "default": "delivery"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Reliable delivery"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Clear delivery updates and practical shipping options for everyday orders.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Get Yours trust grid",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "icon": "delivery",
            "title": "Reliable delivery",
            "text": "<p>Clear delivery updates and practical shipping options for everyday orders.</p>"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "support",
            "title": "Easy support",
            "text": "<p>Need help before or after ordering? Get support through our customer service channels.</p>"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "secure",
            "title": "Secure checkout",
            "text": "<p>Shop with trusted Shopify checkout and supported payment methods.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
