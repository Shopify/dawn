{% doc %}
  Renders the shared Get Yours cart reassurance message.

  This keeps the cart drawer, cart page, and cart notification aligned.
{% enddoc %}

<div class="gy-cart-reassurance" role="note">
  <p class="gy-cart-reassurance__item">
    <span class="gy-cart-reassurance__marker" aria-hidden="true"></span>
    <span>{{ 'sections.cart.free_shipping_reassurance' | t }}</span>
  </p>
  <p class="gy-cart-reassurance__item">
    <span class="gy-cart-reassurance__marker" aria-hidden="true"></span>
    <span>{{ 'sections.cart.support_reassurance' | t }}</span>
  </p>
</div>
