{% doc %}
  Renders a decorative Get Yours line icon.

  @param {string} icon - Icon name.

  @example
  {% render 'gy-icon', icon: 'home' %}
{% enddoc %}

<svg class="gy-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
  {%- case icon -%}
    {%- when 'home' -%}
      <path d="M4 10.5 12 4l8 6.5M6.5 9.5V20h11V9.5M9 20v-6h6v6" />
    {%- when 'desk' -%}
      <path d="M3 7h18v4H3zM5 11v9M19 11v9M9 11v4h6v-4" />
    {%- when 'kitchen' -%}
      <path d="M5 4h14v16H5zM5 10h14M9 7h2M9 14h2" />
    {%- when 'lifestyle' -%}
      <path d="M12 20c4-2.3 7-5.3 7-9a7 7 0 0 0-14 0c0 3.7 3 6.7 7 9Z" />
      <path d="M9 12c1.7 0 3-1.3 3-3 1.7 0 3 1.3 3 3-1.7 0-3 1.3-3 3 0-1.7-1.3-3-3-3Z" />
    {%- when 'travel' -%}
      <path d="m3 14 18-8-6 14-3-5-5-1-4 0Z" />
      <path d="m12 15 4-4" />
    {%- when 'tech' -%}
      <rect x="3" y="5" width="12" height="14" rx="1.5" />
      <rect x="16" y="8" width="5" height="9" rx="1" />
      <path d="M7 16h4M18 14h1" />
    {%- when 'secure' -%}
      <path d="M12 3 5 6v5c0 4.6 2.8 8 7 10 4.2-2 7-5.4 7-10V6l-7-3Z" />
      <path d="m9 12 2 2 4-4" />
    {%- when 'delivery' -%}
      <path d="M3 6h11v10H3zM14 9h4l3 3v4h-7z" />
      <circle cx="7" cy="18" r="2" /><circle cx="18" cy="18" r="2" />
    {%- when 'support' -%}
      <path d="M5 13v-2a7 7 0 0 1 14 0v2M5 13H3v5h4v-5H5ZM19 13h2v5h-4v-5h2ZM17 19c-1 1-2.7 2-5 2" />
    {%- when 'cart' -%}
      <path d="M3 4h2l2 11h10l2-7H6M9 10h7" />
      <circle cx="9" cy="19" r="1.5" /><circle cx="17" cy="19" r="1.5" />
    {%- when 'check' -%}
      <circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16 9" />
    {%- else -%}
      <circle cx="12" cy="12" r="9" />
  {%- endcase -%}
</svg>
