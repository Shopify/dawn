{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "product_details": {
      "type": "cellife-content-grid",
      "settings": {
        "heading": "Get to know your product.",
        "layout": "benefits",
        "tone": "soft",
        "eyebrow": ""
      },
      "blocks": {
        "item_0": {
          "type": "item",
          "settings": {
            "heading": "Ingredients / contents",
            "text": "<p>Connect approved product-specific content using a dynamic source.</p>",
            "placeholder_label": "Contents infographic placeholder",
            "draft": true
          }
        },
        "item_1": {
          "type": "item",
          "settings": {
            "heading": "Directions / intended use",
            "text": "<p>Add the product’s approved directions, intended use and limitations.</p>",
            "placeholder_label": "Directions infographic placeholder",
            "draft": true
          }
        },
        "item_2": {
          "type": "item",
          "settings": {
            "heading": "Suitability & warnings",
            "text": "<p>Add product-specific warnings and suitability information.</p>",
            "placeholder_label": "Warning infographic placeholder",
            "draft": true
          }
        }
      },
      "block_order": [
        "item_0",
        "item_1",
        "item_2"
      ]
    },
    "product_story": {
      "type": "cellife-editorial",
      "settings": {
        "heading": "A closer look.",
        "text": "<p>Add approved product-specific imagery, information and evidence here. This section is a draft, not a product claim.</p>",
        "tone": "light",
        "image_position": "left",
        "draft": true,
        "label": "",
        "link": "",
        "placeholder_label": "Editorial image placeholder"
      }
    },
    "product_questions": {
      "type": "cellife-faq",
      "settings": {
        "heading": "Product questions.",
        "tone": "soft",
        "eyebrow": "YOUR QUESTIONS"
      },
      "blocks": {
        "q0": {
          "type": "question",
          "settings": {
            "question": "What is included?",
            "answer": "<p>Add the approved Cellife answer, relevant product guidance and any necessary policy links.</p>",
            "draft": true
          }
        },
        "q1": {
          "type": "question",
          "settings": {
            "question": "Where are the directions and warnings?",
            "answer": "<p>Add the approved Cellife answer, relevant product guidance and any necessary policy links.</p>",
            "draft": true
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "How do I find delivery information?",
            "answer": "<p>Add the approved Cellife answer, relevant product guidance and any necessary policy links.</p>",
            "draft": true
          }
        }
      },
      "block_order": [
        "q0",
        "q1",
        "q2"
      ]
    }
  },
  "order": [
    "main",
    "disclosures",
    "product_details",
    "product_story",
    "product_questions",
    "related-products"
  ]
}
