{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "rating": {
          "type": "rating",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "text_style": "body",
            "inventory_threshold": 5,
            "show_inventory_quantity": true
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "size_guide": {
          "type": "size_guide",
          "settings": {
            "label": "Size guide",
            "heading": "Find your size",
            "page": "",
            "intro": "<p>Measurements are body measurements in centimetres. If you are between sizes, we recommend sizing up for a relaxed fit.</p>",
            "show_default_table": true,
            "column_size": "Size",
            "column_bust": "Bust (cm)",
            "column_waist": "Waist (cm)",
            "column_hips": "Hips (cm)",
            "notes": "<p>Need help choosing? Contact us and our team will be happy to advise.</p>"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "trust": {
          "type": "icon-with-text",
          "settings": {
            "layout": "vertical",
            "icon_1": "truck",
            "heading_1": "Free delivery over €60",
            "icon_2": "return",
            "heading_2": "30-day returns",
            "icon_3": "lock",
            "heading_3": "Secure checkout"
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "fabric": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Fabric & care",
            "icon": "washing",
            "content": "<p>Add the fabric composition and care instructions for this product here, or connect this tab to a product metafield.</p>",
            "page": ""
          }
        },
        "delivery": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Delivery & returns",
            "icon": "truck",
            "content": "<p>Orders are dispatched within 1–2 business days. Free delivery on orders over €60. Unworn items can be returned or exchanged within 30 days.</p>",
            "page": ""
          }
        },
        "complementary": {
          "type": "complementary",
          "settings": {
            "block_heading": "Complete the look",
            "make_collapsible_row": false,
            "icon": "price_tag",
            "product_list_limit": 6,
            "products_per_page": 2,
            "pagination_style": "counter",
            "image_ratio": "portrait",
            "enable_quick_add": true
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "rating",
        "price",
        "inventory",
        "variant_picker",
        "size_guide",
        "buy_buttons",
        "trust",
        "description",
        "fabric",
        "delivery",
        "complementary",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "columns",
        "media_size": "large",
        "constrain_to_viewport": false,
        "media_fit": "cover",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 16,
        "padding_bottom": 48
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h1",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": true,
        "columns_mobile": "2",
        "padding_top": 64,
        "padding_bottom": 64
      }
    },
    "sticky_atc": {
      "type": "rons-sticky-atc",
      "settings": {
        "show_on_desktop": true,
        "show_image": true,
        "color_scheme": "scheme-1"
      }
    }
  },
  "order": [
    "main",
    "sticky_atc",
    "disclosures",
    "related-products"
  ]
}
