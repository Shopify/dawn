{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "rating": {
          "type": "rating"
        },
        "title": {
          "type": "title"
        },
        "product_type": {
          "type": "product_type"
        },
        "byline": {
          "type": "byline",
          "settings": {
            "prefix": "By"
          }
        },
        "price": {
          "type": "price"
        },
        "more_designs": {
          "type": "more_designs",
          "settings": {
            "heading": "More Designs",
            "limit": 12,
            "link_label": "Expand"
          }
        },
        "card_2": {
          "type": "card_break"
        },
        "specs": {
          "type": "spec_bars",
          "settings": {
            "segments": 6,
            "label_1": "Impact Level",
            "value_1": "4",
            "note_1": "8.2ft | 2.5m",
            "min_1": "Min.",
            "max_1": "Max.",
            "label_2": "Thickness",
            "value_2": "2",
            "note_2": "",
            "min_2": "Slim",
            "max_2": "Sturdy"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "card_3": {
          "type": "card_break"
        },
        "warranty": {
          "type": "info_card",
          "settings": {
            "heading": "Product Warranty",
            "icon": "shield",
            "text": "<p>Up to <strong>24 months</strong> for club members.<br>6 months standard coverage.</p><p>Coverage varies by product and membership status. <a href=\"/policies/refund-policy\" title=\"Refund policy\">Terms apply</a>.</p>"
          }
        },
        "card_4": {
          "type": "card_break"
        },
        "description": {
          "type": "description"
        },
        "details": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Product Details",
            "icon": "none",
            "content": "<p>Add materials, dimensions and compatibility details here.</p>"
          }
        },
        "shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & Returns",
            "icon": "none",
            "content": "<p>Free shipping on orders over $40. 10-day no questions asked returns and exchanges.</p>"
          }
        },
        "faqs": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "FAQs",
            "icon": "none",
            "content": "<p>Add your frequently asked questions here.</p>"
          }
        },
        "features": {
          "type": "feature_grid",
          "settings": {}
        },
        "card_5": {
          "type": "card_break"
        },
        "about": {
          "type": "link_card",
          "settings": {
            "heading": "About the artist",
            "button_label": "Browse Artist Gallery"
          }
        }
      },
      "block_order": [
        "rating",
        "title",
        "product_type",
        "byline",
        "price",
        "more_designs",
        "card_2",
        "specs",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "card_3",
        "warranty",
        "card_4",
        "description",
        "details",
        "shipping",
        "faqs",
        "features",
        "card_5",
        "about"
      ],
      "settings": {
        "enable_sticky_info": false,
        "color_scheme": "scheme-2",
        "media_position": "left",
        "gallery_layout": "thumbnail",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 28,
        "padding_bottom": 36,
        "info_style": "cards",
        "show_sticky_bar": true
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}
