      "type": "collapsible-content",
      "blocks": {
        "faq-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I choose my size?",
            "icon": "none",
            "row_content": "<p>Every product page has a size guide with body measurements. If you are between sizes, we recommend sizing up for a relaxed, comfortable fit.</p>",
            "page": ""
          }
        },
        "faq-2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What fabrics do you use?",
            "icon": "none",
            "row_content": "<p>We work with soft, breathable fabrics such as cotton, modal and satin. You will find the exact composition and care instructions on each product page.</p>",
            "page": ""
          }
        },
        "faq-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long does delivery take?",
            "icon": "none",
            "row_content": "<p>Orders are prepared and dispatched within 1–2 business days. You will receive a tracking link as soon as your parcel leaves us.</p>",
            "page": ""
          }
        },
        "faq-4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I return or exchange my order?",
            "icon": "none",
            "row_content": "<p>Yes. You can return or exchange unworn items within 30 days. See our refund policy for full details.</p>",
            "page": ""
          }
        },
        "faq-5": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do you offer gift wrapping?",
            "icon": "none",
            "row_content": "<p>Every order is carefully packed. Add a note at checkout and we will include a personal message with your gift.</p>",
            "page": ""
          }
        }
      },
