{% comment %}
  Get Yours — Brand Story
  Editorial value-proposition block with image and clean typography.
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #GyBrandStory-{{ section.id }} .gy-brand-story {
    display: grid;
    gap: var(--gy-gap-lg);
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    #GyBrandStory-{{ section.id }} .gy-brand-story {
      grid-template-columns: 1fr 1fr;
      gap: clamp(3rem, 5vw, 6rem);
    }
  }

  #GyBrandStory-{{ section.id }} .gy-brand-story__media {
    border-radius: var(--gy-radius-lg);
    overflow: hidden;
    box-shadow: var(--gy-shadow-md);
  }

  #GyBrandStory-{{ section.id }} .gy-brand-story__media img {
    width: 100%;
    height: auto;
    display: block;
  }

  #GyBrandStory-{{ section.id }} .gy-brand-story__content {
    max-width: 52rem;
  }

  #GyBrandStory-{{ section.id }} .gy-brand-story__heading {
    font-size: clamp(2.2rem, 3vw, 3.2rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 1.6rem;
  }

  #GyBrandStory-{{ section.id }} .gy-brand-story__text {
    font-size: var(--gy-text-md);
    line-height: 1.7;
    color: var(--gy-text-muted);
    margin: 0 0 2.4rem;
  }

  @media screen and (max-width: 749px) {
    #GyBrandStory-{{ section.id }} .gy-brand-story {
      text-align: center;
    }
    #GyBrandStory-{{ section.id }} .gy-brand-story__content {
      margin: 0 auto;
    }
  }
{%- endstyle -%}

<div id="GyBrandStory-{{ section.id }}" class="color-{{ section.settings.color_scheme }} gradient{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
  <div class="page-width section-{{ section.id }}-padding isolate">
    <div class="gy-brand-story">
      {%- if section.settings.image != blank -%}
        <div class="gy-brand-story__media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {%- assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio -%}
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag:
              width: section.settings.image.width,
              height: image_height,
              loading: 'lazy',
              sizes: '(min-width: 750px) 50vw, 100vw',
              widths: '375, 550, 750, 1100, 1500'
          }}
        </div>
      {%- endif -%}

      <div class="gy-brand-story__content{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.heading != blank -%}
          <h2 class="gy-brand-story__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="gy-brand-story__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="button{% if section.settings.button_style_secondary %} button--secondary{% endif %}">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "GY Brand Story",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Built for people who know what they want",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Get Yours brings together products that matter — carefully sourced, quality checked, and delivered reliably. We focus on the details so you can focus on enjoying what you buy.</p>",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Learn more",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "default": false,
      "label": "Use secondary button style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "GY Brand Story"
    }
  ]
}
{% endschema %}
