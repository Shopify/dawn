{{ 'cellife-journeys.css' | asset_url | stylesheet_tag }}
{%- capture supplements_url -%}{%- render 'cellife-journey-url', journey: 'supplements' -%}{%- endcapture -%}
{%- capture diagnostics_url -%}{%- render 'cellife-journey-url', journey: 'diagnostics' -%}{%- endcapture -%}
<section class="cellife-journeys cellife-gateway" aria-labelledby="Gateway-{{ section.id }}">
  <div class="cellife-journeys__intro"><p class="cellife-journeys__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="Gateway-{{ section.id }}">{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p></div>
  <div class="cellife-journeys__grid">
    {% render 'cellife-journey-card', image: section.settings.supplements_image, number: '01', heading: section.settings.supplements_title, text: section.settings.supplements_text, url: supplements_url, label: section.settings.supplements_label, journey: 'supplements' %}
    {% render 'cellife-journey-card', image: section.settings.diagnostics_image, number: '02', heading: section.settings.diagnostics_title, text: section.settings.diagnostics_text, url: diagnostics_url, label: section.settings.diagnostics_label, journey: 'diagnostics' %}
  </div>
</section>
{% if section.settings.overlay_enabled and request.page_type == 'index' and request.design_mode == false %}
  <cellife-journey-dialog>
    <dialog class="cellife-journey-dialog" aria-labelledby="JourneyDialog-{{ section.id }}" aria-describedby="JourneyDialogText-{{ section.id }}">
      <div class="cellife-journey-dialog__panel">
        <button type="button" class="cellife-journey-dialog__close" data-cellife-dismiss autofocus>{{ section.settings.dismiss_label | escape }} <span aria-hidden="true">×</span></button>
        <h2 id="JourneyDialog-{{ section.id }}">{{ section.settings.overlay_heading | escape }}</h2>
        <p id="JourneyDialogText-{{ section.id }}">{{ section.settings.overlay_text | escape }}</p>
        <div class="cellife-journey-dialog__choices">
          <a href="{{ supplements_url | escape }}" data-cellife-choice="supplements">{{ section.settings.supplements_title | escape }} <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12"/></svg></a>
          <a href="{{ diagnostics_url | escape }}" data-cellife-choice="diagnostics">{{ section.settings.diagnostics_title | escape }} <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12"/></svg></a>
        </div>
      </div>
    </dialog>
  </cellife-journey-dialog>
{% endif %}

{% schema %}
{
  "name": "Cellife journey gateway",
  "limit": 1,
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "TWO WAYS TO EXPLORE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What brings you to Cellife?"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Introduction",
      "default": "Choose a starting point. Both ranges are always available to explore."
    },
    {
      "type": "image_picker",
      "id": "supplements_image",
      "label": "Supplements image"
    },
    {
      "type": "text",
      "id": "supplements_title",
      "label": "Supplements heading",
      "default": "Supplements"
    },
    {
      "type": "text",
      "id": "supplements_text",
      "label": "Supplements description",
      "default": "Explore the Cellife supplement range."
    },
    {
      "type": "text",
      "id": "supplements_label",
      "label": "Supplements link label",
      "default": "Explore supplements"
    },
    {
      "type": "image_picker",
      "id": "diagnostics_image",
      "label": "Diagnostic Test Kits image"
    },
    {
      "type": "text",
      "id": "diagnostics_title",
      "label": "Diagnostic Test Kits heading",
      "default": "Diagnostic Test Kits"
    },
    {
      "type": "text",
      "id": "diagnostics_text",
      "label": "Diagnostic Test Kits description",
      "default": "Browse respiratory, drug and alcohol, and women\u2019s and urinary health tests."
    },
    {
      "type": "text",
      "id": "diagnostics_label",
      "label": "Diagnostic Test Kits link label",
      "default": "Explore diagnostic test kits"
    },
    {
      "type": "checkbox",
      "id": "overlay_enabled",
      "label": "Enable first-visit homepage overlay",
      "info": "Only new homepage entries. Disabled in the Theme Editor. Choice or dismissal is remembered in this browser. Both pathways remain available below.",
      "default": false
    },
    {
      "type": "text",
      "id": "overlay_heading",
      "label": "Overlay heading",
      "default": "Where would you like to start?"
    },
    {
      "type": "text",
      "id": "overlay_text",
      "label": "Overlay description",
      "default": "Explore supplements or diagnostic test kits. You can switch at any time."
    },
    {
      "type": "text",
      "id": "dismiss_label",
      "label": "Dismiss label",
      "default": "Continue browsing"
    }
  ],
  "presets": [
    {
      "name": "Cellife journey gateway"
    }
  ]
}
{% endschema %}
