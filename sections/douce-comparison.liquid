{%- comment -%} DOUCE: comparison table against alternatives, with a sticky intro. {%- endcomment -%}
<section
  class="dc-section color-{{ section.settings.color_scheme }}{% if section.settings.accent_italic %} dc-accent-italic{% endif %}"
  style="--dc-pt: {{ section.settings.padding_top }}px; --dc-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="dc-container">
    <div class="dc-compare">
      <div class="dc-compare__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="dc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="dc-heading dc-heading--m">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="dc-text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- render 'douce-button',
          label: section.settings.button_label,
          link: section.settings.button_link,
          style: section.settings.button_style,
          size: 'm'
        -%}
      </div>

      <div>
        <table class="dc-compare__table">
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">{{ section.settings.feature_label | escape }}</span></th>
              <th scope="col" class="dc-compare__brand">{{ section.settings.column_1 | escape }}</th>
              <th scope="col">{{ section.settings.column_2 | escape }}</th>
              {%- if section.settings.column_3 != blank -%}
                <th scope="col">{{ section.settings.column_3 | escape }}</th>
              {%- endif -%}
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ block.settings.label | escape }}</th>
                <td class="dc-compare__brand">{{ block.settings.value_1 | escape }}</td>
                <td>{{ block.settings.value_2 | escape }}</td>
                {%- if section.settings.column_3 != blank -%}
                  <td>{{ block.settings.value_3 | escape }}</td>
                {%- endif -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DOUCE comparison",
  "tag": "div",
  "class": "section-douce-comparison",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Compare" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Not all filters <em>are equal.</em>" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Most filtered showerheads hide the cartridge. DOUCE shows you exactly what it's catching.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "info": "Hidden on mobile. Leave empty to hide.", "default": "Shop DOUCE" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "primary", "label": "Color scheme button" },
        { "value": "secondary", "label": "Outline" }
      ],
      "default": "dark"
    },
    {
      "type": "header",
      "content": "Table columns"
    },
    { "type": "text", "id": "feature_label", "label": "Feature column name (screen readers)", "default": "Feature" },
    { "type": "text", "id": "column_1", "label": "Highlighted column", "default": "DOUCE" },
    { "type": "text", "id": "column_2", "label": "Column 2", "default": "Standard head" },
    { "type": "text", "id": "column_3", "label": "Column 3", "info": "Leave empty for a two-way comparison.", "default": "Wall-mount filter" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "accent_italic", "label": "Accent colour on italic words", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "label", "label": "Feature", "default": "Reduces chlorine" },
        { "type": "text", "id": "value_1", "label": "Highlighted column value", "default": "Yes" },
        { "type": "text", "id": "value_2", "label": "Column 2 value", "default": "—" },
        { "type": "text", "id": "value_3", "label": "Column 3 value", "default": "Yes" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DOUCE comparison",
      "blocks": [
        { "type": "row", "settings": { "label": "Reduces chlorine", "value_1": "Yes", "value_2": "—", "value_3": "Yes" } },
        { "type": "row", "settings": { "label": "Catches sediment & rust", "value_1": "Yes", "value_2": "—", "value_3": "Some" } },
        { "type": "row", "settings": { "label": "See when to change it", "value_1": "Clear handle", "value_2": "—", "value_3": "—" } },
        { "type": "row", "settings": { "label": "Tool-free install", "value_1": "2 min", "value_2": "Yes", "value_3": "Wrench" } },
        { "type": "row", "settings": { "label": "Filter refills", "value_1": "$24 / 3", "value_2": "—", "value_3": "$40+" } },
        { "type": "row", "settings": { "label": "60-day guarantee", "value_1": "Yes", "value_2": "—", "value_3": "Varies" } }
      ]
    }
  ]
}
{% endschema %}
