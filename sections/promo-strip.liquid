<div
  class="promo-strip"
  style="--cs-bg: {{ section.settings.background }}; --cs-text: {{ section.settings.text_color }};"
>
  {{ section.settings.text }}
</div>

{% schema %}
{
  "name": "Promo strip",
  "tag": "section",
  "class": "section section-promo-strip",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Unlock Exclusive Savings on Our Curated Bundles! | <a href=\"/collections/all\" title=\"Shop now\">SHOP NOW</a></p>"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Promo strip"
    }
  ]
}
{% endschema %}
