<div
  class="bento-grid cs-section"
  style="--cs-bg: {{ section.settings.background }}; --cs-text: {{ section.settings.text_color }}; --bento-row: {{ section.settings.row_height }}px; --cs-pad-top: {{ section.settings.padding_top }}px; --cs-pad-bottom: {{ section.settings.padding_bottom }}px; --cs-pad-top-mobile: {{ section.settings.padding_top | times: 0.75 | round }}px; --cs-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.75 | round }}px;"
>
  <div class="cs-container">
    {%- if section.settings.heading != blank -%}
      <div class="cs-header-row">
        <h2 class="cs-heading">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="bento-grid__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign title = block.settings.title | default: collection.title
          assign image = block.settings.image | default: collection.featured_image
          assign link = block.settings.link | default: collection.url
          if block.settings.size == 'wide'
            assign sizes = '(min-width: 750px) 50vw, 100vw'
          else
            assign sizes = '(min-width: 750px) 25vw, 50vw'
          endif
        -%}
        <a
          {% if link != blank %}
            href="{{ link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          class="bento-grid__tile{% if block.settings.size == 'wide' %} bento-grid__tile--wide{% endif %}"
          style="--tile-text: {{ block.settings.text_color }};"
          {{ block.shopify_attributes }}
        >
          <div class="cs-media">
            {%- if block.settings.video != blank -%}
              {{
                block.settings.video
                | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1100x'
              }}
            {%- elsif image != blank -%}
              {{
                image
                | image_url: width: 1600
                | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1600', sizes: sizes, alt: title
              }}
            {%- else -%}
              {%- assign placeholder_index = forloop.index0 | modulo: 6 | plus: 1 -%}
              {{ 'collection-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          {%- if title != blank -%}
            <h3 class="bento-grid__title">{{ title | escape }}</h3>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bento grid",
  "tag": "section",
  "class": "section section-bento-grid",
  "max_blocks": 24,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Selling"
    },
    {
      "type": "range",
      "id": "row_height",
      "min": 200,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Desktop row height",
      "default": 310
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            { "value": "small", "label": "Small (1 column)" },
            { "value": "wide", "label": "Wide (2 columns)" }
          ],
          "default": "small",
          "info": "Desktop rows are 4 columns: use one wide + two small tiles per row"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Fills in the image, title and link automatically"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Optional. Plays muted and looped in place of the image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Title color",
          "default": "#000000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bento grid",
      "blocks": [
        { "type": "tile", "settings": { "size": "wide", "title": "Phone Cases" } },
        { "type": "tile", "settings": { "title": "Phone Straps" } },
        { "type": "tile", "settings": { "title": "MagSafe Compatible" } },
        { "type": "tile", "settings": { "title": "Watch Bands" } },
        { "type": "tile", "settings": { "title": "Earbuds Cases" } },
        { "type": "tile", "settings": { "size": "wide", "title": "Charms" } }
      ]
    }
  ]
}
{% endschema %}
