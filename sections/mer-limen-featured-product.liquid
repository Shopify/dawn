{%- assign featured_product = section.settings.product -%}
{%- if featured_product != blank -%}
  <section class="ml-featured ml-surface--{{ section.settings.background_treatment }} ml-featured--{{ section.settings.layout }} ml-featured--image-{{ section.settings.image_position }}" style="--ml-section-space: {{ section.settings.section_space }}px;">
    <div class="ml-featured__inner page-width">
      <a class="ml-featured__media" href="{{ featured_product.url }}" aria-label="{{ featured_product.title | escape }}">
        {%- if featured_product.featured_media != blank -%}{{ featured_product.featured_media.preview_image | image_url: width: 1600 | image_tag: widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 990px) 55vw, 100vw', loading: 'lazy', alt: featured_product.featured_media.alt | default: featured_product.title }}{%- else -%}<span class="ml-featured__media-fallback" aria-hidden="true"></span>{%- endif -%}
        <span class="ml-featured__media-label">OBJECT / 01</span>
      </a>
      <div class="ml-featured__content">
        {%- if section.settings.eyebrow != blank -%}<p class="ml-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<p class="ml-featured__intro">{{ section.settings.heading | escape }}</p>{%- endif -%}
        <h2 class="ml-display ml-featured__title">{{ featured_product.title | escape }}</h2>
        <div class="ml-featured__price">{% render 'price', product: featured_product, use_variant: true, show_compare_at_price: true %}</div>
        {%- if section.settings.show_description and featured_product.description != blank -%}<div class="ml-copy ml-featured__description">{{ featured_product.description | strip_html | truncatewords: 42 | escape }}</div>{%- endif -%}
        <p class="ml-featured__availability{% unless featured_product.available %} is-sold-out{% endunless %}"><span aria-hidden="true"></span>{%- if featured_product.available -%}Available to explore{%- else -%}Currently unavailable{%- endif -%}</p>
        <a class="ml-button" href="{{ featured_product.url }}"><span>Explore product</span><span class="ml-button__arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}<section class="ml-featured ml-surface--midnight ml-featured--empty"><div class="page-width"><p class="ml-eyebrow">MƎR LIMEN / FEATURED OBJECT</p><p>Select a product in this section's settings. This optional section stays hidden from customers until a product is chosen.</p></div></section>{%- endif -%}
{% schema %}
{
  "name": "MƎR-LIMEN featured item",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"IN FOCUS"},
    {"type":"text","id":"heading","label":"Introductory line","default":"One object. One ritual."},
    {"type":"product","id":"product","label":"Product"},
    {"type":"checkbox","id":"show_description","label":"Show product description","default":true},
    {"type":"select","id":"layout","label":"Layout","default":"split","options":[{"value":"split","label":"Split image and text"},{"value":"wide","label":"Wide image with text below"}]},
    {"type":"select","id":"image_position","label":"Image placement","default":"left","options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}]},
    {"type":"select","id":"background_treatment","label":"Background","default":"indigo","options":[{"value":"void","label":"Void"},{"value":"midnight","label":"Midnight"},{"value":"indigo","label":"Deep indigo"}]},
    {"type":"range","id":"section_space","label":"Vertical spacing","min":40,"max":160,"step":20,"unit":"px","default":100}
  ],
  "presets": [{"name":"MƎR LIMEN featured item"}]
}
{% endschema %}