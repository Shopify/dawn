{%- comment -%} DOUCE: before/after photo pairs with a title and note. {%- endcomment -%}
<section
  class="dc-section color-{{ section.settings.color_scheme }}{% if section.settings.accent_italic %} dc-accent-italic{% endif %}"
  style="--dc-pt: {{ section.settings.padding_top }}px; --dc-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="dc-container">
    {%- if section.settings.heading != blank -%}
      <div class="dc-row-head">
        <h2 class="dc-heading dc-heading--s">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <ul class="dc-ba-pairs" role="list" style="--dc-cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <li class="dc-ba-pair" {{ block.shopify_attributes }}>
          <div class="dc-ba-pair__images">
            <div class="dc-media">
              {%- render 'douce-image', image: block.settings.image_before, sizes: '(min-width: 750px) 17vw, 50vw', placeholder: 'product-apparel-2' -%}
              {%- if section.settings.label_before != blank -%}
                <span class="dc-pill">{{ section.settings.label_before | escape }}</span>
              {%- endif -%}
            </div>
            <div class="dc-media">
              {%- render 'douce-image', image: block.settings.image_after, sizes: '(min-width: 750px) 17vw, 50vw', placeholder: 'product-apparel-3' -%}
              {%- if section.settings.label_after != blank -%}
                <span class="dc-pill dc-pill--dark">{{ section.settings.label_after | escape }}</span>
              {%- endif -%}
            </div>
          </div>
          {%- if block.settings.title != blank -%}
            <h3 class="dc-ba-pair__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.note != blank -%}
            <p class="dc-note">{{ block.settings.note | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "DOUCE before/after pairs",
  "tag": "div",
  "class": "section-douce-ba-pairs",
  "max_blocks": 6,
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Before & after" },
    { "type": "text", "id": "label_before", "label": "Before label", "default": "Before" },
    { "type": "text", "id": "label_after", "label": "After label", "default": "After" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 1, "max": 3, "step": 1, "default": 3 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "accent_italic", "label": "Accent colour on italic words", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 }
  ],
  "blocks": [
    {
      "type": "pair",
      "name": "Pair",
      "settings": [
        { "type": "image_picker", "id": "image_before", "label": "Before image" },
        { "type": "image_picker", "id": "image_after", "label": "After image" },
        { "type": "text", "id": "title", "label": "Title", "default": "The PP filter, day 1 vs. day 60" },
        { "type": "text", "id": "note", "label": "Note", "default": "Tester in Phoenix, AZ" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DOUCE before/after pairs",
      "blocks": [
        { "type": "pair", "settings": { "title": "The PP filter, day 1 vs. day 60", "note": "Tester in Phoenix, AZ" } },
        { "type": "pair", "settings": { "title": "Glass door, 4 weeks apart", "note": "Tester in Austin, TX" } },
        { "type": "pair", "settings": { "title": "Hair, before and after 3 weeks", "note": "Tester in Chicago, IL" } }
      ]
    }
  ]
}
{% endschema %}
