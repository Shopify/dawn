<section class="cellife-section cellife-tone--{{ section.settings.tone }}" aria-labelledby="Editorial-{{ section.id }}">
  <div class="cellife-container"><div class="cellife-section-heading">
  {% if section.settings.eyebrow != blank %}<p class="cellife-kicker">{{ section.settings.eyebrow | escape }}</p>{% endif %}
  <h2 id="Editorial-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
</div>
    <div class="cellife-content-grid cellife-content-grid--{{ section.settings.layout }}">
      {% for block in section.blocks %}
        <article class="cellife-content-card" {{ block.shopify_attributes }}>
          <div class="cellife-content-card__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1000 | image_tag: widths: '300, 500, 750, 1000', sizes: '(min-width: 990px) 28vw, (min-width: 750px) 44vw, 90vw', loading: 'lazy' }}
            {% else %}
              {% render 'cellife-media-placeholder', label: block.settings.placeholder_label %}
            {% endif %}
          </div>
          <div class="cellife-content-card__body">
            {% if block.settings.draft %}<p class="cellife-draft-label">{{ section.settings.draft_label | escape }}</p>{% endif %}
            <h3>{{ block.settings.heading | escape }}</h3>
            {% if block.settings.text != blank %}<div class="rte">{{ block.settings.text }}</div>{% endif %}
            {% if block.settings.link != blank and block.settings.label != blank %}<a class="cellife-editorial-link" href="{{ block.settings.link }}">{{ block.settings.label | escape }} <span aria-hidden="true">&rarr;</span></a>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cellife content grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        {
          "value": "light",
          "label": "White"
        },
        {
          "value": "soft",
          "label": "Soft platinum"
        },
        {
          "value": "dark",
          "label": "Brand blue"
        }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "cards",
          "label": "Editorial cards"
        },
        {
          "value": "logos",
          "label": "Evidence / logo strip"
        },
        {
          "value": "people",
          "label": "Expert profiles"
        },
        {
          "value": "benefits",
          "label": "Product information"
        }
      ],
      "default": "cards"
    },
    {
      "type": "text",
      "id": "draft_label",
      "label": "Draft content label",
      "default": "Content placeholder — approval required"
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "item",
      "name": "Content card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "placeholder_label",
          "label": "Missing-image label",
          "default": "Image placeholder"
        },
        {
          "type": "checkbox",
          "id": "draft",
          "label": "Mark this content as a draft",
          "default": true
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Content placeholder"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Body"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link destination"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cellife content grid",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
