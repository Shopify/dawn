{%- liquid
  assign rem_image = section.settings.image | default: settings.ml_rem_cycle
  assign show_rem_image = false
  if section.settings.show_image and rem_image != blank
    assign show_rem_image = true
  endif
-%}
<section class="ml-rem ml-surface--{{ section.settings.background_treatment }}{% if show_rem_image %} ml-rem--has-image ml-rem--image-{{ section.settings.image_alignment }}{% else %} ml-rem--no-image{% endif %}" style="--ml-section-space: {{ section.settings.section_space }}px; --ml-rem-width: {{ section.settings.media_width }}%;">
  <div class="ml-rem__inner page-width">
    <div class="ml-rem__content">
      {%- if section.settings.eyebrow != blank -%}<p class="ml-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="ml-display ml-rem__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<div class="ml-copy ml-rem__body">{{ section.settings.body }}</div>{%- endif -%}
      {%- if section.settings.show_image_caption and section.settings.image_caption != blank and show_rem_image -%}<p class="ml-rem__caption">{{ section.settings.image_caption | escape }}</p>{%- endif -%}
    </div>
    <div class="ml-rem__visual{% unless show_rem_image %} ml-rem__visual--abstract{% endunless %}">
      {%- if show_rem_image -%}
        <figure class="ml-rem__figure">{{ rem_image | image_url: width: 1800 | image_tag: widths: '480, 720, 960, 1200, 1500, 1800', sizes: '(min-width: 990px) 55vw, 100vw', loading: 'lazy', alt: section.settings.image_alt | default: rem_image.alt | default: 'REM sleep cycle diagram' }}</figure>
        <p class="ml-rem__image-note"><span aria-hidden="true">↗</span> SLEEP / REM CYCLE</p>
      {%- else -%}<div class="ml-rem__abstract-mark" aria-hidden="true"><span></span><span></span><span></span></div>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "MƎR-LIMEN REM cycle",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"OBSERVE THE NIGHT / 01"},
    {"type":"textarea","id":"heading","label":"Heading","default":"A map of the night."},
    {"type":"richtext","id":"body","label":"Body text","default":"<p>Sleep is not a single, unchanging state. The REM cycle offers one lens through which to observe its changing patterns—an invitation to look a little closer.</p>"},
    {"type":"image_picker","id":"image","label":"Section image","info":"Leave empty to use the shared REM-cycle image in Theme settings."},
    {"type":"text","id":"image_alt","label":"Image alternative text","info":"Describe the uploaded diagram if its default alt text is not suitable."},
    {"type":"checkbox","id":"show_image","label":"Show diagram","default":true},
    {"type":"range","id":"media_width","label":"Image column width","min":35,"max":60,"step":5,"unit":"%","default":50},
    {"type":"select","id":"image_alignment","label":"Image placement","default":"right","options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}]},
    {"type":"select","id":"background_treatment","label":"Background","default":"midnight","options":[{"value":"void","label":"Void"},{"value":"midnight","label":"Midnight"},{"value":"indigo","label":"Deep indigo"}]},
    {"type":"checkbox","id":"show_image_caption","label":"Show image caption","default":false},
    {"type":"textarea","id":"image_caption","label":"Image caption"},
    {"type":"range","id":"section_space","label":"Vertical spacing","min":40,"max":160,"step":20,"unit":"px","default":100}
  ],
  "presets": [{"name":"MƎR LIMEN REM cycle"}]
}
{% endschema %}