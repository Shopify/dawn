{%- comment -%} DOUCE: centered page intro with an optional wide image. {%- endcomment -%}
<section
  class="dc-section color-{{ section.settings.color_scheme }}{% if section.settings.accent_italic %} dc-accent-italic{% endif %}"
  style="--dc-pt: {{ section.settings.padding_top }}px; --dc-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="dc-container dc-intro">
    {%- if section.settings.eyebrow != blank -%}
      <p class="dc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- liquid
      assign intro_heading = section.settings.heading
      if intro_heading == blank and page != blank
        assign intro_heading = page.title | escape
      endif
    -%}
    {%- if intro_heading != blank -%}
      <h1 class="dc-heading">{{ intro_heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="dc-text">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.show_image -%}
      <div class="dc-media dc-intro__media">
        {%- render 'douce-image', image: section.settings.image, sizes: '100vw', eager: true, placeholder: 'lifestyle-2' -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "DOUCE page intro",
  "tag": "div",
  "class": "section-douce-page-intro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The science" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the page title.",
      "default": "What's in your water, <em>and what DOUCE takes out.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>A plain-language guide to chlorine, hard water and how a two-stage shower filter works.</p>"
    },
    { "type": "checkbox", "id": "show_image", "label": "Show wide image", "default": true },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "accent_italic", "label": "Accent colour on italic words", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [
    {
      "name": "DOUCE page intro"
    }
  ]
}
{% endschema %}
