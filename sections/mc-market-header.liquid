<header class="mc-market-header">
  <div class="mc-market-header__top">
    <div class="page-width mc-market-header__top-inner">
      <span>🚚 Free shipping on eligible orders</span>
      <span class="mc-promo-hide">🔒 Secure payments</span>
      <span class="mc-promo-hide">↩ Easy returns</span>
    </div>
  </div>

  <div class="page-width mc-market-header__main">
    <a class="mc-brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">Mana<span><em>Choice</em></span></a>

    <div class="mc-search">
      <form action="{{ routes.search_url }}" method="get" role="search">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products, brands and more..." aria-label="Search products, brands and more">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" aria-label="Search">⌕</button>
      </form>
    </div>

    <nav class="mc-market-actions" aria-label="Account actions">
      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}"><span class="mc-action-icon">👤</span><span>Account</span></a>
      {% endif %}
      <a href="{{ routes.root_url }}pages/wishlist"><span class="mc-action-icon">♡</span><span>Wishlist</span></a>
      <a href="{{ routes.cart_url }}"><span class="mc-action-icon">🛒</span><span>Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</span></a>
    </nav>
  </div>

  <div class="page-width mc-mobile-search">
    <div class="mc-search">
      <form action="{{ routes.search_url }}" method="get" role="search">
        <input type="search" name="q" placeholder="Search products, brands and more..." aria-label="Search products, brands and more">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" aria-label="Search">⌕</button>
      </form>
    </div>
  </div>

  <div class="mc-market-nav">
    <nav class="page-width mc-market-nav__inner" aria-label="Main navigation">
      <a href="{{ routes.all_products_collection_url }}" class="mc-active">All</a>
      <a href="{{ routes.all_products_collection_url }}?q=electronics">Electronics</a>
      <a href="{{ routes.all_products_collection_url }}?q=fashion">Fashion</a>
      <a href="{{ routes.all_products_collection_url }}?q=home">Home &amp; Living</a>
      <a href="{{ routes.all_products_collection_url }}?q=travel">Travel</a>
      <a href="{{ routes.all_products_collection_url }}?q=gadgets">Gadgets</a>
      <a href="{{ routes.all_products_collection_url }}?q=pets">Pets</a>
      <a href="{{ routes.all_products_collection_url }}?q=deals">Deals</a>
    </nav>
  </div>
</header>
