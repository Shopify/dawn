{%- comment -%} DOUCE: tall image, wide image and a statement card. {%- endcomment -%}
<section
  class="dc-section color-{{ section.settings.color_scheme }}"
  style="--dc-pt: {{ section.settings.padding_top }}px; --dc-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="dc-container">
    <div class="dc-collage">
      <div class="dc-media dc-collage__tall">
        {%- render 'douce-image', image: section.settings.image_1, sizes: '(min-width: 750px) 50vw, 100vw', placeholder: 'lifestyle-1' -%}
      </div>
      <div class="dc-collage__right">
        <div class="dc-media">
          {%- render 'douce-image', image: section.settings.image_2, sizes: '(min-width: 750px) 50vw, 100vw', placeholder: 'lifestyle-2' -%}
        </div>
        {%- if section.settings.card_heading != blank or section.settings.card_eyebrow != blank -%}
          <div class="dc-collage__card color-{{ section.settings.card_color_scheme }}">
            {%- if section.settings.card_eyebrow != blank -%}
              <p class="dc-eyebrow">{{ section.settings.card_eyebrow | escape }}</p>
            {%- endif -%}
            {%- if section.settings.card_heading != blank -%}
              <p class="dc-title">{{ section.settings.card_heading }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DOUCE image collage",
  "tag": "div",
  "class": "section-douce-collage",
  "settings": [
    { "type": "image_picker", "id": "image_1", "label": "Tall image" },
    { "type": "image_picker", "id": "image_2", "label": "Wide image" },
    { "type": "text", "id": "card_eyebrow", "label": "Card eyebrow", "default": "What we won't say" },
    {
      "type": "inline_richtext",
      "id": "card_heading",
      "label": "Card statement",
      "default": "DOUCE won't cure eczema or stop hair loss. It makes the water you shower in kinder, and that's often enough to feel."
    },
    { "type": "color_scheme", "id": "card_color_scheme", "label": "Card color scheme", "default": "scheme-3" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [
    {
      "name": "DOUCE image collage"
    }
  ]
}
{% endschema %}
