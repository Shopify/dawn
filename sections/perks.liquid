<div
  class="perks cs-section"
  style="--cs-bg: {{ section.settings.background }}; --cs-text: {{ section.settings.text_color }}; --cs-pad-top: {{ section.settings.padding_top }}px; --cs-pad-bottom: {{ section.settings.padding_bottom }}px; --cs-pad-top-mobile: {{ section.settings.padding_top | times: 0.75 | round }}px; --cs-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.75 | round }}px;"
>
  <div class="cs-container">
    <ul class="perks__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="perks__item" {{ block.shopify_attributes }}>
          <span class="perks__icon">
            {%- if block.settings.custom_icon != blank -%}
              {{ block.settings.custom_icon | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              {% render 'cs-icon', icon: block.settings.icon %}
            {%- endif -%}
          </span>
          {{ block.settings.text }}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Perks",
  "tag": "section",
  "class": "section section-perks",
  "max_blocks": 9,
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#F2F2F2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Perk",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "trophy", "label": "Trophy" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return box" },
            { "value": "secure", "label": "Secure checkout" },
            { "value": "warranty", "label": "Warranty badge" },
            { "value": "heart", "label": "Heart" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "chat", "label": "Chat" },
            { "value": "gift", "label": "Gift" }
          ],
          "default": "trophy"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon",
          "info": "Optional. Replaces the icon above"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Award Winning Design</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Perks",
      "blocks": [
        { "type": "perk", "settings": { "icon": "trophy", "text": "<p>Award Winning Design</p>" } },
        { "type": "perk", "settings": { "icon": "sparkle", "text": "<p>Years of Innovation</p>" } },
        { "type": "perk", "settings": { "icon": "truck", "text": "<p>Free Shipping from $40 USD</p>" } },
        { "type": "perk", "settings": { "icon": "return", "text": "<p>10-day No Questions Asked<br>Return or Exchange</p>" } },
        { "type": "perk", "settings": { "icon": "secure", "text": "<p>Secure Checkout</p>" } },
        { "type": "perk", "settings": { "icon": "warranty", "text": "<p>Up to 24-Month<br>Product Warranty</p>" } }
      ]
    }
  ]
}
{% endschema %}
