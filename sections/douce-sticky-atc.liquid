{%- comment -%}
  DOUCE: sticky add-to-cart bar for product pages. It appears once the main
  Add to cart button scrolls out of view and submits the main product form, so
  the chosen variant, quantity and purchase option are kept.
{%- endcomment -%}
{%- if product != blank -%}
  {%- liquid
    assign current_variant = product.selected_or_first_available_variant
    assign variant_label = current_variant.title
    if product.has_only_default_variant
      assign variant_label = ''
    endif
  -%}
  <douce-sticky-atc
    class="dc-sticky-atc color-{{ section.settings.color_scheme }}"
    data-mobile="{{ section.settings.show_on_mobile }}"
    aria-hidden="true"
  >
    <div class="dc-container dc-sticky-atc__inner">
      <div class="dc-media">
        {%- if product.featured_media != blank -%}
          {{
            product.featured_media
            | image_url: width: 156
            | image_tag: widths: '52, 104, 156', sizes: '52px', loading: 'lazy', alt: ''
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="dc-sticky-atc__info">
        <p class="dc-sticky-atc__title">{{ product.title | escape }}</p>
        <p class="dc-sticky-atc__sub" data-sticky-variant>
          {%- if variant_label != blank -%}
            {{ variant_label | escape }}
          {%- else -%}
            {{ section.settings.subtitle | escape }}
          {%- endif -%}
        </p>
      </div>
      <div class="dc-sticky-atc__price" data-sticky-price>{{ current_variant.price | money }}</div>
      <button
        type="button"
        class="dc-btn dc-btn--{{ section.settings.button_style }} dc-btn--m"
        data-sticky-button
        data-label="{{ section.settings.button_label | escape }}"
        data-sold-out="{{ 'products.product.sold_out' | t | escape }}"
        tabindex="-1"
        {% unless current_variant.available %}
          disabled
        {% endunless %}
      >
        <span data-sticky-label>
          {%- if current_variant.available -%}
            {{ section.settings.button_label | escape }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </span>
      </button>
    </div>
  </douce-sticky-atc>
{%- endif -%}

{% schema %}
{
  "name": "DOUCE sticky add to cart",
  "tag": "div",
  "class": "section-douce-sticky-atc",
  "settings": [
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to cart" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Color scheme button" },
        { "value": "lime", "label": "Lime" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "primary"
    },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "info": "Shown for products without variants.", "default": "Free US delivery" },
    { "type": "checkbox", "id": "show_on_mobile", "label": "Show on mobile", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "DOUCE sticky add to cart"
    }
  ]
}
{% endschema %}
