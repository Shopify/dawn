{%- assign has_image = false -%}{%- if section.settings.image != blank -%}{%- assign has_image = true -%}{%- endif -%}
<section class="ml-editorial ml-editorial--{{ section.settings.layout }} ml-surface--{{ section.settings.background_treatment }} ml-align--{{ section.settings.alignment }}{% if has_image %} ml-editorial--has-image{% endif %}{% if section.settings.show_border %} ml-editorial--ruled{% endif %}" style="--ml-section-space: {{ section.settings.section_space }}px;">
  <div class="ml-editorial__inner page-width">
    {%- if has_image -%}<figure class="ml-editorial__media">{{ section.settings.image | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 990px) 48vw, 100vw', loading: 'lazy', alt: section.settings.image_alt | default: section.settings.image.alt }}</figure>{%- endif -%}
    <div class="ml-editorial__content">
      {%- if section.settings.eyebrow != blank -%}<p class="ml-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="ml-display ml-editorial__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<div class="ml-copy ml-editorial__body">{{ section.settings.body }}</div>{%- endif -%}
      {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}<a class="ml-text-link ml-editorial__link" href="{{ section.settings.link_url }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">↗</span></a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "MƎR-LIMEN editorial",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"A DIFFERENT KIND OF THRESHOLD"},
    {"type":"textarea","id":"heading","label":"Heading","default":"Night is not an absence.\nIt is another kind of passage."},
    {"type":"richtext","id":"body","label":"Body text","default":"<p>Thoughtful objects for the time we spend between waking life and dreams.</p>"},
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"image_alt","label":"Image alternative text"},
    {"type":"select","id":"layout","label":"Layout","default":"statement","options":[{"value":"statement","label":"Editorial statement"},{"value":"split-left","label":"Image left, text right"},{"value":"split-right","label":"Text left, image right"},{"value":"invitation","label":"Closing invitation"}]},
    {"type":"select","id":"background_treatment","label":"Background","default":"void","options":[{"value":"void","label":"Void"},{"value":"midnight","label":"Midnight"},{"value":"indigo","label":"Deep indigo"}]},
    {"type":"select","id":"alignment","label":"Text alignment","default":"center","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}]},
    {"type":"range","id":"section_space","label":"Vertical spacing","min":40,"max":160,"step":20,"unit":"px","default":100},
    {"type":"text","id":"link_label","label":"Link label"},
    {"type":"url","id":"link_url","label":"Link destination"},
    {"type":"checkbox","id":"show_border","label":"Show fine divider","default":false}
  ],
  "presets": [{"name":"MƎR LIMEN editorial"}]
}
{% endschema %}