{%- comment -%} DOUCE: press or customer quote cards. {%- endcomment -%}
<section
  class="dc-section color-{{ section.settings.color_scheme }}"
  style="--dc-pt: {{ section.settings.padding_top }}px; --dc-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="dc-container">
    {%- if section.settings.heading != blank -%}
      <div class="dc-row-head">
        <h2 class="dc-heading dc-heading--s">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <ul class="dc-quotes" role="list" style="--dc-cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <figure class="dc-quote">
            <blockquote>“{{ block.settings.quote | escape }}”</blockquote>
            <figcaption>
              {%- if block.settings.logo != blank -%}
                {{ block.settings.logo | image_url: width: 280 | image_tag: loading: 'lazy', alt: block.settings.source }}
              {%- else -%}
                {{ block.settings.source | escape }}
              {%- endif -%}
            </figcaption>
          </figure>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "DOUCE quotes",
  "tag": "div",
  "class": "section-douce-quotes",
  "max_blocks": 6,
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Optional." },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 1, "max": 3, "step": 1, "default": 3 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Press quote goes here, kept to one line." },
        { "type": "image_picker", "id": "logo", "label": "Publication logo" },
        { "type": "text", "id": "source", "label": "Source", "info": "Shown when there is no logo, and used as alt text.", "default": "Publication" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DOUCE quotes",
      "blocks": [
        { "type": "quote", "settings": { "quote": "Press quote goes here, kept to one line." } },
        { "type": "quote", "settings": { "quote": "A second short pull-quote from coverage." } },
        { "type": "quote", "settings": { "quote": "Third quote, ideally about the visible filter." } }
      ]
    }
  ]
}
{% endschema %}
