{{ 'section-cellife-pages.css' | asset_url | stylesheet_tag }}
<div class="cellife-directory color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width cellife-directory__grid">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'region' %}<h2 class="cellife-directory__region h1" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
        {% when 'column' %}<div class="cellife-directory__column rte" {{ block.shopify_attributes }}>{{ block.settings.content }}</div>
      {% endcase %}
    {% endfor %}
  </div>
</div>
{% schema %}
{
  "name": "Cellife directory",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "region",
      "name": "Region heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "column",
      "name": "Directory column",
      "settings": [
        {
          "type": "liquid",
          "id": "content",
          "label": "Stockist content (HTML)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cellife directory"
    }
  ]
}
{% endschema %}
