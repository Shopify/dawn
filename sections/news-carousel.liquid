<div
  class="news-carousel cs-section"
  style="--cs-bg: {{ section.settings.background }}; --cs-text: {{ section.settings.text_color }}; --cs-pad-top: {{ section.settings.padding_top }}px; --cs-pad-bottom: {{ section.settings.padding_bottom }}px; --cs-pad-top-mobile: {{ section.settings.padding_top | times: 0.75 | round }}px; --cs-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.75 | round }}px;"
>
  <div class="cs-container">
    {%- if section.settings.heading != blank -%}
      <div class="cs-header-row">
        <h2 class="cs-heading">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <cs-scroller id="Scroller-{{ section.id }}" class="cs-scroller">
      <ul class="cs-scroller__track" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign article = block.settings.article
            assign title = block.settings.title | default: article.title
            assign image = block.settings.image | default: article.image
            assign link = block.settings.link | default: article.url
          -%}
          <li
            class="news-card"
            style="--card-bg: {{ block.settings.card_color }}; --card-text: {{ block.settings.card_text_color }};"
            {{ block.shopify_attributes }}
          >
            <div class="cs-media">
              {%- if image != blank -%}
                {{
                  image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', widths: '300, 470, 600', sizes: '235px', alt: title
                }}
              {%- else -%}
                {%- assign placeholder_index = forloop.index0 | modulo: 6 | plus: 1 -%}
                {{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="news-card__body">
              <h3 class="news-card__title">{{ title | escape }}</h3>
              {%- if block.settings.button_label != blank -%}
                <a
                  {% if link != blank %}
                    href="{{ link }}"
                  {% else %}
                    role="link" aria-disabled="true"
                  {% endif %}
                  class="cs-pill"
                >
                  {{- block.settings.button_label | escape -}}
                  {%- if title != blank -%}<span class="visually-hidden">: {{ title | escape }}</span>{%- endif -%}
                </a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </cs-scroller>

    {%- if section.blocks.size > 1 -%}
      <div class="news-carousel__footer cs-scroller__nav">
        <button
          type="button"
          class="cs-arrow"
          data-scroller-prev="Scroller-{{ section.id }}"
          aria-label="{{ 'general.slider.previous_slide' | t }}"
        >
          {% render 'cs-icon', icon: 'arrow-left' %}
        </button>
        <button
          type="button"
          class="cs-arrow"
          data-scroller-next="Scroller-{{ section.id }}"
          aria-label="{{ 'general.slider.next_slide' | t }}"
        >
          {% render 'cs-icon', icon: 'arrow-right' %}
        </button>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "News carousel",
  "tag": "section",
  "class": "section section-news-carousel",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest News"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#F2F2F2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Blog post",
          "info": "Fills in the image, title and link automatically"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Built for Real Life: Our Standards"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Learn More"
        },
        {
          "type": "color",
          "id": "card_color",
          "label": "Card color",
          "default": "#1FA35C"
        },
        {
          "type": "color",
          "id": "card_text_color",
          "label": "Card text color",
          "default": "#000000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "News carousel",
      "blocks": [
        { "type": "story", "settings": { "title": "Stop Chasing Trends: Quality is the Only Lasting Advantage", "card_color": "#1FA35C" } },
        { "type": "story", "settings": { "title": "Our Standards: Built for Real Life", "card_color": "#F5E063" } },
        { "type": "story", "settings": { "title": "The Case Guide: Top 5 Questions Everyone Asks", "card_color": "#FDC8D6" } },
        { "type": "story", "settings": { "title": "We Won a Design Award", "card_color": "#2C5DAB", "card_text_color": "#FFFFFF" } },
        { "type": "story", "settings": { "title": "New Cases: Available Now", "card_color": "#F25A3C" } }
      ]
    }
  ]
}
{% endschema %}
