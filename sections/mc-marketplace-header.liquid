<div class="mc-marketplace-header">
  <div class="mc-marketplace-header__top">
    <div class="page-width mc-marketplace-header__top-inner">
      <span>🚚 Free shipping on eligible orders</span>
      <span>🔒 Secure payments</span>
      <span>↩ Easy returns</span>
    </div>
  </div>
  <div class="page-width mc-marketplace-header__main">
    <a class="mc-logo" href="{{ routes.root_url }}" aria-label="ManaChoice home">Mana<span>Choice</span><b>.</b></a>
    <div class="mc-search">
      <form action="{{ routes.search_url }}" method="get" role="search">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products, brands and more..." aria-label="Search products">
        <input type="hidden" name="type" value="product">
        <button type="submit" aria-label="Search">⌕</button>
      </form>
    </div>
    <div class="mc-actions">
      <a class="mc-action" href="{{ routes.account_url }}">👤 <span class="label">Account</span></a>
      <a class="mc-action" href="/pages/wishlist">♡ <span class="label">Wishlist</span></a>
      <a class="mc-action" href="{{ routes.cart_url }}">🛒 <span class="label">Cart</span>{% if cart.item_count > 0 %}<span class="mc-cart-count">{{ cart.item_count }}</span>{% endif %}</a>
    </div>
  </div>
  <nav class="mc-marketplace-nav" aria-label="Main navigation">
    <div class="page-width mc-marketplace-nav__inner">
      <a class="mc-nav-link" href="{{ routes.all_products_collection_url }}">All</a>
      <a class="mc-nav-link" href="/collections/electronics">Electronics</a>
      <a class="mc-nav-link" href="/collections/fashion">Fashion</a>
      <a class="mc-nav-link" href="/collections/home-living">Home &amp; Living</a>
      <a class="mc-nav-link" href="/collections/travel">Travel</a>
      <a class="mc-nav-link" href="/collections/gadgets">Gadgets</a>
      <a class="mc-nav-link" href="/collections/pets">Pets</a>
      <a class="mc-nav-link mc-nav-link--deals" href="{{ routes.all_products_collection_url }}">🔥 Deals</a>
      <a class="mc-nav-link" href="{{ routes.search_url }}">New arrivals</a>
    </div>
  </nav>
</div>

{% schema %}
{
  "name": "ManaChoice marketplace header",
  "settings": [],
  "presets": [{"name":"ManaChoice marketplace header"}]
}
{% endschema %}