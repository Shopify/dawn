{{ 'section-cellife-home.css' | asset_url | stylesheet_tag }}
<section id="cellife-shopping-pathways" class="cellife-home cellife-pathways" aria-labelledby="CellifePathwaysHeading-{{ section.id }}">
  <div class="cellife-pathways__heading">
    <p class="cellife-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 id="CellifePathwaysHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  </div>
  <div class="cellife-pathways__grid">
    {% for block in section.blocks %}
      <article class="cellife-pathway" {{ block.shopify_attributes }}>
        <div class="cellife-pathway__media">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '400, 600, 900, 1200', sizes: '(min-width: 750px) 45vw, 100vw', loading: 'lazy' }}
          {% else %}
            <div class="cellife-placeholder"><span class="cellife-placeholder__symbol" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span><p>Image placeholder — {{ block.settings.heading | escape }}</p></div>
          {% endif %}
        </div>
        <div class="cellife-pathway__copy">
          <h3>{{ block.settings.heading | escape }}</h3>
          {% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}
          {% if block.settings.link != blank and block.settings.link_label != blank %}<a class="cellife-text-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Cellife shopping pathways",
  "tag": "div",
  "limit": 1,
  "enabled_on": { "templates": ["index"] },
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "EXPLORE CELLIFE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your starting point."
    }
  ],
  "blocks": [
    {
      "type": "pathway",
      "name": "Shopping pathway",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Supplements"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Explore range"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Destination"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cellife shopping pathways",
      "blocks": [
        {
          "type": "pathway"
        },
        {
          "type": "pathway"
        }
      ]
    }
  ]
}
{% endschema %}
