<div
  class="feature-cards cs-section"
  style="--cs-bg: {{ section.settings.background }}; --cs-text: {{ section.settings.text_color }}; --cs-pad-top: {{ section.settings.padding_top }}px; --cs-pad-bottom: {{ section.settings.padding_bottom }}px; --cs-pad-top-mobile: {{ section.settings.padding_top | times: 0.75 | round }}px; --cs-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.75 | round }}px;"
>
  <div class="cs-container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="cs-header-row">
        <div>
          {%- if section.settings.heading != blank -%}
            <h2 class="cs-heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <div class="cs-subheading">{{ section.settings.subheading }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  <cs-scroller id="Scroller-{{ section.id }}" class="cs-scroller">
    <ul class="cs-scroller__track" role="list">
      {%- for block in section.blocks -%}
        <li class="feature-card" {{ block.shopify_attributes }}>
          <div class="cs-media">
            {%- if block.settings.video != blank -%}
              {{
                block.settings.video
                | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '600x'
              }}
            {%- elsif block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 750
                | image_tag: loading: 'lazy', widths: '300, 470, 750', sizes: '(min-width: 1200px) 20vw, 235px'
              }}
            {%- else -%}
              {%- assign placeholder_index = forloop.index0 | modulo: 6 | plus: 1 -%}
              {{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="feature-card__body">
            {%- if block.settings.title != blank -%}
              <h3 class="feature-card__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.subtitle != blank -%}
              <p class="feature-card__subtitle">{{ block.settings.subtitle | escape }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="feature-card__text">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a
                {% if block.settings.button_link != blank %}
                  href="{{ block.settings.button_link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
                class="cs-pill"
              >
                {{- block.settings.button_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </cs-scroller>
</div>

{% schema %}
{
  "name": "Feature cards",
  "tag": "section",
  "class": "section section-feature-cards",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Standard"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Real life happens. We've got your back, with protection that rises to meet your life.</p>"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#E8E8E8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Optional. Plays muted and looped in place of the image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Impact Case"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Drop-tested protection"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Shock-absorbing corners and a raised bezel keep your phone safe from everyday drops.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature cards",
      "blocks": [
        { "type": "card" },
        { "type": "card", "settings": { "title": "Bounce Case", "subtitle": "Reinforced corners" } },
        { "type": "card", "settings": { "title": "Cross-body Strap", "subtitle": "Upgraded clasps" } },
        { "type": "card", "settings": { "title": "Ring Stand Case", "subtitle": "Kickstand integration" } },
        { "type": "card", "settings": { "title": "Clear Case", "subtitle": "Anti-yellowing" } }
      ]
    }
  ]
}
{% endschema %}
