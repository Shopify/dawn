{% comment %}
  Get Yours — Promo / Discount Grid
  Booster-inspired promotional tiles with tasteful colour accents,
  material-style elevation, and editable copy.
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #GyPromo-{{ section.id }} .gy-promo__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    gap: var(--gy-grid-gap);
  }

  @media screen and (min-width: 750px) {
    #GyPromo-{{ section.id }} .gy-promo__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    }
  }

  #GyPromo-{{ section.id }} .gy-promo__tile {
    position: relative;
    border-radius: var(--gy-radius-lg);
    overflow: hidden;
    box-shadow: var(--gy-shadow-md);
    transition: transform var(--gy-transition-base), box-shadow var(--gy-transition-base);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 220px;
    padding: 2.4rem;
    background: var(--gy-card-bg);
  }

  @media screen and (min-width: 750px) {
    #GyPromo-{{ section.id }} .gy-promo__tile {
      min-height: 280px;
    }
  }

  @media screen and (min-width: 990px) {
    #GyPromo-{{ section.id }} .gy-promo__tile:hover {
      transform: translateY(-6px);
      box-shadow: var(--gy-shadow-hover);
    }
  }

  #GyPromo-{{ section.id }} .gy-promo__tile--image {
    justify-content: flex-end;
  }

  #GyPromo-{{ section.id }} .gy-promo__tile-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #GyPromo-{{ section.id }} .gy-promo__tile-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #GyPromo-{{ section.id }} .gy-promo__tile-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.1) 60%, rgba(0,0,0,0) 100%);
  }

  #GyPromo-{{ section.id }} .gy-promo__content {
    position: relative;
    z-index: 2;
  }

  #GyPromo-{{ section.id }} .gy-promo__badge {
    display: inline-block;
    font-size: var(--gy-text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.4rem 1rem;
    border-radius: var(--gy-radius-sm);
    margin-bottom: 1rem;
    background: var(--gy-primary);
    color: #ffffff;
  }

  #GyPromo-{{ section.id }} .gy-promo__title {
    font-size: var(--gy-text-xl);
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 0.6rem;
    color: inherit;
  }

  #GyPromo-{{ section.id }} .gy-promo__text {
    font-size: var(--gy-text-sm);
    line-height: 1.5;
    margin: 0;
    opacity: 0.9;
  }

  #GyPromo-{{ section.id }} .gy-promo__tile--dark .gy-promo__title,
  #GyPromo-{{ section.id }} .gy-promo__tile--dark .gy-promo__text {
    color: #ffffff;
  }

  #GyPromo-{{ section.id }} .gy-promo__tile--light .gy-promo__title,
  #GyPromo-{{ section.id }} .gy-promo__tile--light .gy-promo__text {
    color: var(--gy-text);
  }
{%- endstyle -%}

<div id="GyPromo-{{ section.id }}" class="color-{{ section.settings.color_scheme }} gradient{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
  <div class="page-width section-{{ section.id }}-padding isolate">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper-with-link title-wrapper--no-top-margin">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endif -%}

    <div class="gy-promo__grid">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="gy-promo__tile gy-promo__tile--{{ block.settings.color_style }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {{ block.shopify_attributes }}
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
        >
          {%- if block.settings.image != blank -%}
            <div class="gy-promo__tile-bg">
              {%- assign image_height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio -%}
              {{
                block.settings.image
                | image_url: width: 1100
                | image_tag:
                  width: block.settings.image.width,
                  height: image_height,
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                  widths: '375, 550, 750, 1100'
              }}
            </div>
            <div class="gy-promo__tile-overlay"></div>
          {%- endif -%}

          <div class="gy-promo__content">
            {%- if block.settings.badge != blank -%}
              <span class="gy-promo__badge">{{ block.settings.badge | escape }}</span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="gy-promo__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="gy-promo__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "GY Promo Grid",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "Offers & Promotions",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Columns desktop"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 1,
      "label": "Columns mobile"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "badge",
          "default": "Up to 40% off",
          "label": "Badge text"
        },
        {
          "type": "text",
          "id": "title",
          "default": "New arrivals",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "default": "Discover the latest trends this season.",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "color_style",
          "options": [
            { "value": "light", "label": "Light text on image" },
            { "value": "dark", "label": "Dark text on image" }
          ],
          "default": "dark",
          "label": "Text style"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GY Promo Grid",
      "blocks": [
        { "type": "promo" },
        { "type": "promo" },
        { "type": "promo" }
      ]
    }
  ]
}
{% endschema %}
