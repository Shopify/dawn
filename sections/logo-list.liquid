<div
  class="logo-list cs-section"
  style="--cs-bg: {{ section.settings.background }}; --cs-text: {{ section.settings.text_color }}; --logo-count: {{ section.blocks.size | at_least: 1 }}; --logo-height: {{ section.settings.logo_height }}px; --cs-pad-top: {{ section.settings.padding_top }}px; --cs-pad-bottom: {{ section.settings.padding_bottom }}px; --cs-pad-top-mobile: {{ section.settings.padding_top | times: 0.75 | round }}px; --cs-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.75 | round }}px;"
>
  <div class="cs-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="cs-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="logo-list__row" role="list">
      {%- for block in section.blocks -%}
        <li
          class="logo-list__item{% if section.settings.grayscale %} logo-list__item--grayscale{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="cs-link-reset">{%- endif -%}
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 400
              | image_tag: loading: 'lazy', widths: '200, 400', sizes: '200px', alt: block.settings.name
            }}
          {%- else -%}
            <span class="logo-list__fallback">{{ block.settings.name | escape }}</span>
          {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Logo list",
  "tag": "section",
  "class": "section section-logo-list",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As Seen In"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Logo height",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Show logos in black & white",
      "default": false
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "info": "Shown as text until a logo image is added, and used as the image's alt text",
          "default": "Publication"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo list",
      "blocks": [
        { "type": "logo", "settings": { "name": "Publication One" } },
        { "type": "logo", "settings": { "name": "Publication Two" } },
        { "type": "logo", "settings": { "name": "Publication Three" } },
        { "type": "logo", "settings": { "name": "Publication Four" } }
      ]
    }
  ]
}
{% endschema %}
