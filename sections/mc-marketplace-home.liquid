{{ 'mana-choice-marketplace.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mana-choice-marketplace.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign featured_collection = section.settings.featured_collection
  if featured_collection == blank
    assign featured_collection = collections.all
  endif
-%}

<section class="mc-home" data-section-id="{{ section.id }}">
  <div class="mc-promo-strip"><div class="page-width mc-promo-strip__inner"><span>🚚 Free shipping on eligible orders</span><span class="mc-promo-hide-mobile">🔒 Secure checkout</span><span>↩ Easy returns</span></div></div>
  <div class="page-width mc-home__hero"><div class="mc-hero-card"><div class="mc-hero-copy"><p class="mc-eyebrow">MANA CHOICE · DISCOVER MORE</p><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.subheading }}</p><div class="mc-hero-actions"><a class="mc-btn mc-btn--primary" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }}</a><a class="mc-btn mc-btn--ghost" href="{{ section.settings.secondary_link | default: routes.search_url }}">{{ section.settings.secondary_label }}</a></div></div><div class="mc-hero-art" aria-hidden="true"><div class="mc-orbit mc-orbit--one"></div><div class="mc-orbit mc-orbit--two"></div><div class="mc-hero-art__card"><span>✨</span><strong>Fresh finds</strong><small>Picked for curious shoppers</small></div></div></div></div>
  <div class="page-width mc-section"><div class="mc-section-head"><div><p class="mc-kicker">BROWSE</p><h2>{{ section.settings.categories_heading }}</h2></div><a href="{{ routes.collections_url }}">View all</a></div><div class="mc-category-grid">{%- for block in section.blocks -%}{%- if block.type == 'category' -%}<a class="mc-category-card" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}><span class="mc-category-icon">{{ block.settings.icon }}</span><strong>{{ block.settings.title }}</strong><small>{{ block.settings.subtitle }}</small><span class="mc-category-arrow">→</span></a>{%- endif -%}{%- endfor -%}</div></div>
  <div class="page-width mc-section"><div class="mc-section-head"><div><p class="mc-kicker">TRENDING NOW</p><h2>{{ section.settings.featured_heading }}</h2></div><a href="{{ featured_collection.url }}">Shop all</a></div>{%- if featured_collection.products_count > 0 -%}<div class="mc-product-grid">{%- for product in featured_collection.products limit: section.settings.products_to_show -%}{% render 'card-product', card_product: product, section_id: section.id, show_vendor: true, show_rating: true, quick_add: 'standard' %}{%- endfor -%}</div>{%- else -%}<div class="mc-empty-note">Add products to your catalog to populate this section.</div>{%- endif -%}</div>
  <div class="page-width mc-section"><div class="mc-deal-card"><div><p class="mc-kicker">MANA DEALS</p><h2>{{ section.settings.deal_heading }}</h2><p>{{ section.settings.deal_text }}</p></div><a class="mc-btn mc-btn--primary" href="{{ section.settings.deal_link | default: routes.all_products_collection_url }}">Shop deals</a></div></div>
  <div class="page-width mc-section"><div class="mc-benefit-grid"><div><span>🚚</span><strong>Reliable delivery</strong><small>Track your order from checkout to doorstep.</small></div><div><span>🔒</span><strong>Secure payments</strong><small>Checkout powered by Shopify.</small></div><div><span>↩</span><strong>Easy returns</strong><small>Clear policies and support when you need it.</small></div><div><span>💜</span><strong>Curated choices</strong><small>Useful products without endless scrolling.</small></div></div></div>
</section>

{% schema %}
{"name":"ManaChoice marketplace home","tag":"section","settings":[{"type":"text","id":"heading","label":"Hero heading","default":"Discover things you'll wish you found sooner."},{"type":"textarea","id":"subheading","label":"Hero subheading","default":"Trending finds, everyday essentials and products worth discovering — all in one place."},{"type":"text","id":"primary_label","label":"Primary button","default":"Shop all"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Explore deals"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"text","id":"categories_heading","label":"Categories heading","default":"Shop by category"},{"type":"text","id":"featured_heading","label":"Product section heading","default":"Popular picks"},{"type":"collection","id":"featured_collection","label":"Product collection"},{"type":"range","id":"products_to_show","min":4,"max":16,"step":4,"label":"Products to show","default":8},{"type":"text","id":"deal_heading","label":"Deal heading","default":"Good products. Better prices."},{"type":"textarea","id":"deal_text","label":"Deal text","default":"Find limited-time offers and everyday value across the store."},{"type":"url","id":"deal_link","label":"Deal link"}],"blocks":[{"type":"category","name":"Category","settings":[{"type":"text","id":"icon","label":"Icon","default":"✦"},{"type":"text","id":"title","label":"Title","default":"Electronics"},{"type":"text","id":"subtitle","label":"Subtitle","default":"Smart tech & accessories"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"ManaChoice marketplace home","blocks":[{"type":"category","settings":{"icon":"⚡","title":"Electronics","subtitle":"Smart tech & accessories"}},{"type":"category","settings":{"icon":"👕","title":"Fashion","subtitle":"Everyday styles & picks"}},{"type":"category","settings":{"icon":"🏠","title":"Home & Living","subtitle":"Useful things for home"}},{"type":"category","settings":{"icon":"✈️","title":"Travel","subtitle":"Travel smarter"}},{"type":"category","settings":{"icon":"🎮","title":"Gadgets","subtitle":"Fun & useful tech"}},{"type":"category","settings":{"icon":"🐾","title":"Pets","subtitle":"For your furry friends"}}]}]}
{% endschema %}