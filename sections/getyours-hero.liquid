{% comment %}
  Get Yours — Hero Section
  Clean, conversion-focused hero with editable headline, subheadline,
  primary/secondary CTAs, and optional background image.
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #GyHero-{{ section.id }} {
    --gy-hero-overlay: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
  }

  #GyHero-{{ section.id }} .gy-hero__content {
    {% if section.settings.content_alignment == 'center' %}
      align-items: center;
      text-align: center;
    {% elsif section.settings.content_alignment == 'right' %}
      align-items: flex-end;
      text-align: right;
    {% else %}
      align-items: flex-start;
      text-align: left;
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    #GyHero-{{ section.id }} .gy-hero__content {
      align-items: {{ section.settings.mobile_content_alignment }};
      text-align: {{ section.settings.mobile_content_alignment }};
    }
  }
{%- endstyle -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

<div
  id="GyHero-{{ section.id }}"
  class="gy-hero color-{{ section.settings.color_scheme }} gradient{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  {%- if section.settings.image != blank -%}
    <div class="gy-hero__media media">
      {%- assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio -%}
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image.width,
          height: image_height,
          class: 'gy-hero__image',
          sizes: '100vw',
          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
          fetchpriority: fetch_priority
      }}
    </div>
    <div class="gy-hero__overlay" style="opacity: var(--gy-hero-overlay);"></div>
  {%- else -%}
    <div class="gy-hero__media media placeholder">
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}

  <div class="gy-hero__content page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="gy-hero__heading{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="gy-hero__subheading{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ section.settings.subheading }}
      </p>
    {%- endif -%}

    {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
      <div class="gy-hero__actions{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.button_label_1 != blank -%}
          <a
            href="{{ section.settings.button_link_1 | default: '#' }}"
            class="button{% if section.settings.button_style_secondary_1 %} button--secondary{% endif %}"
          >
            {{ section.settings.button_label_1 | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a
            href="{{ section.settings.button_link_2 | default: '#' }}"
            class="button{% if section.settings.button_style_secondary_2 %} button--secondary{% endif %}"
          >
            {{ section.settings.button_label_2 | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "GY Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30,
      "unit": "%",
      "label": "Image overlay opacity"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Find what you love",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "default": "Curated products for a modern lifestyle. Shop the latest arrivals with fast, reliable delivery.",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "default": "Shop now",
      "label": "Primary button label"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary button link"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary_1",
      "default": false,
      "label": "Use secondary style for primary button"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "default": "View collections",
      "label": "Secondary button label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary_2",
      "default": true,
      "label": "Use secondary style for secondary button"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "label": "Desktop content alignment"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "label": "Mobile content alignment"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "GY Hero"
    }
  ]
}
{% endschema %}
