{{ 'section-cellife-story-mosaic.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cellife-story-rail.js' | asset_url }}" defer="defer"></script>
<section class="cellife-section cellife-tone--{{ section.settings.tone }}" aria-labelledby="Editorial-{{ section.id }}">
  <div class="cellife-container">
    <div class="cellife-section-heading">
      {% if section.settings.eyebrow != blank %}<p class="cellife-kicker">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="Editorial-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
    </div>
    <cellife-story-rail data-layout="mosaic" data-auto-scroll="{{ section.settings.auto_scroll }}" data-speed="{{ section.settings.scroll_speed }}">
      <div class="cellife-story-controls"><button type="button" data-rail-toggle hidden data-pause-label="{{ section.settings.pause_label | escape }}" data-play-label="{{ section.settings.play_label | escape }}">{{ section.settings.pause_label | escape }}</button></div>
      <div class="cellife-story-viewport" tabindex="0" role="region" aria-label="{{ section.settings.rail_label | escape }}">
        <div class="cellife-community-grid" data-story-track aria-live="off">
          {% assign stories = section.blocks | where: 'type', 'story' %}
          {% for block in stories %}
            {% assign slot = forloop.index0 | modulo: 7 %}
            {% case slot %}
              {% when 0 %}<div class="cellife-story-unit cellife-story-unit--trio" data-story-unit>
              {% when 3 or 6 %}<div class="cellife-story-unit cellife-story-unit--portrait" data-story-unit>
              {% when 4 %}<div class="cellife-story-unit cellife-story-unit--stack" data-story-unit>
            {% endcase %}
            {% assign portrait = false %}
            {% if slot == 3 or slot == 6 %}{% assign portrait = true %}{% endif %}
            {% render 'cellife-story-card', block: block, section: section, portrait: portrait %}
            {% if slot == 2 or slot == 3 or slot == 5 or slot == 6 or forloop.last %}</div>{% endif %}
          {% endfor %}
          {% for block in section.blocks %}
            {% if block.type == '@app' %}<div class="cellife-community-app" {{ block.shopify_attributes }}>{% render block %}</div>{% endif %}
          {% endfor %}
        </div>
      </div>
    </cellife-story-rail>
  </div>
</section>

{% schema %}
{
  "name": "Cellife community stories",
  "settings": [
    {
      "type": "paragraph",
      "content": "Each seven-story pattern uses: wide quote, two small quotes, portrait video, two stacked quotes, portrait video. Reorder story blocks to place content in those slots. Add approved media to slots 4 and 7."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        {
          "value": "light",
          "label": "White"
        },
        {
          "value": "soft",
          "label": "Soft platinum"
        },
        {
          "value": "dark",
          "label": "Brand blue"
        }
      ],
      "default": "light"
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Missing-media label",
      "default": "Video story placeholder"
    },
    {
      "type": "text",
      "id": "draft_label",
      "label": "Unapproved content label",
      "default": "Unpublished story placeholder"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Placeholder description",
      "default": "Add a consented customer story, accurate attribution and captions or transcript."
    },
    {
      "type": "text",
      "id": "transcript_label",
      "label": "Transcript label",
      "default": "Read transcript"
    },
    {
      "type": "checkbox",
      "id": "auto_scroll",
      "label": "Move stories left automatically",
      "default": true
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed (pixels per second)",
      "min": 10,
      "max": 50,
      "step": 2,
      "default": 24
    },
    {
      "type": "text",
      "id": "pause_label",
      "label": "Pause button label",
      "default": "Pause stories"
    },
    {
      "type": "text",
      "id": "play_label",
      "label": "Resume button label",
      "default": "Resume stories"
    },
    {
      "type": "text",
      "id": "rail_label",
      "label": "Story rail accessible label",
      "default": "Cellife customer stories"
    }
  ],
  "max_blocks": 14,
  "blocks": [
    {
      "type": "story",
      "name": "Video / customer story",
      "settings": [
        {
          "type": "checkbox",
          "id": "approved",
          "label": "Content and consent approved",
          "info": "Only enable after reviewing the story, attribution, usage consent and accessibility.",
          "default": false
        },
        {
          "type": "video",
          "id": "video",
          "label": "Shopify-hosted video"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster image"
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Approved customer quote"
        },
        {
          "type": "range",
          "id": "quote_text_scale",
          "label": "Quote text size",
          "min": 70,
          "max": 130,
          "step": 5,
          "unit": "%",
          "default": 100,
          "info": "Adjust this story only. 100% keeps the normal size; try 85–90% for a long quote. Text stays at least 14px."
        },
        {
          "type": "text",
          "id": "attribution",
          "label": "Customer name / attribution",
          "info": "Use the customer's approved display name. Put their role, organisation and location in the subtitle below."
        },
        {
          "type": "text",
          "id": "attribution_subtitle",
          "label": "Attribution subtitle",
          "info": "Optional role, organisation and location, for example: Pharmacist · Blooms The Chemist · Crowsnest, NSW, Australia. Use only confirmed details."
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Customer star rating",
          "min": 0,
          "max": 5,
          "step": 0.5,
          "default": 0,
          "info": "0 hides stars. Enter the customer's actual rating only."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show Verified label",
          "default": false,
          "info": "Enable only when this customer's identity or purchase has been independently verified. This is a manual label, not an automatic Shopify verification."
        },
        {
          "type": "richtext",
          "id": "transcript",
          "label": "Transcript"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Related product"
        },
        {
          "type": "checkbox",
          "id": "product_overlay",
          "label": "Overlay related product on portrait video",
          "default": true,
          "info": "Select a related product above. The overlay shows its current image, title and price, and links to the product page."
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Cellife community stories",
      "blocks": [
        {
          "type": "story"
        },
        {
          "type": "story"
        },
        {
          "type": "story"
        },
        {
          "type": "story"
        },
        {
          "type": "story"
        },
        {
          "type": "story"
        },
        {
          "type": "story"
        }
      ]
    }
  ]
}
{% endschema %}
