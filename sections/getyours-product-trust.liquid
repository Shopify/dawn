{% comment %}
  Get Yours — Product Trust Strip
  Conversion-focused trust badges for product pages.
  Place immediately after the main product section in templates/product.json.
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #GyProductTrust-{{ section.id }} .gy-product-trust {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gy-gap-md);
  }

  @media screen and (min-width: 750px) {
    #GyProductTrust-{{ section.id }} .gy-product-trust {
      grid-template-columns: repeat({{ section.blocks.size | at_most: 4 }}, 1fr);
      gap: var(--gy-gap-lg);
    }
  }

  #GyProductTrust-{{ section.id }} .gy-product-trust__item {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 1.6rem;
    background: var(--gy-card-bg);
    border-radius: var(--gy-radius-md);
    border: 1px solid var(--gy-border);
    transition: box-shadow var(--gy-transition-fast), transform var(--gy-transition-fast);
  }

  @media screen and (min-width: 990px) {
    #GyProductTrust-{{ section.id }} .gy-product-trust__item:hover {
      box-shadow: var(--gy-shadow-md);
      transform: translateY(-2px);
    }
  }

  #GyProductTrust-{{ section.id }} .gy-product-trust__icon {
    width: 2.4rem;
    height: 2.4rem;
    flex-shrink: 0;
    color: var(--gy-trust);
  }

  #GyProductTrust-{{ section.id }} .gy-product-trust__text {
    font-size: var(--gy-text-sm);
    font-weight: 600;
    color: var(--gy-text);
    line-height: 1.3;
    margin: 0;
  }

  #GyProductTrust-{{ section.id }} .gy-product-trust__subtext {
    font-size: var(--gy-text-xs);
    color: var(--gy-text-muted);
    margin-top: 0.2rem;
    line-height: 1.4;
  }
{%- endstyle -%}

<div id="GyProductTrust-{{ section.id }}" class="color-{{ section.settings.color_scheme }} gradient{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
  <div class="page-width section-{{ section.id }}-padding isolate">
    <div class="gy-product-trust">
      {%- for block in section.blocks -%}
        <div
          class="gy-product-trust__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {{ block.shopify_attributes }}
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
        >
          {%- if block.settings.icon != blank -%}
            <span class="gy-product-trust__icon">{{ block.settings.icon }}</span>
          {%- else -%}
            <span class="gy-product-trust__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </span>
          {%- endif -%}
          <div>
            <p class="gy-product-trust__text">{{ block.settings.heading }}</p>
            {%- if block.settings.subtext != blank -%}
              <p class="gy-product-trust__subtext">{{ block.settings.subtext }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "GY Product Trust",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "Icon SVG (optional)",
          "info": "Paste a small inline SVG. Falls back to a shield icon."
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Secure checkout",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subtext",
          "default": "Encrypted payments",
          "label": "Subtext"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GY Product Trust",
      "blocks": [
        { "type": "trust_item", "settings": { "heading": "Secure checkout", "subtext": "Encrypted payments" } },
        { "type": "trust_item", "settings": { "heading": "Reliable delivery", "subtext": "Tracked shipping" } },
        { "type": "trust_item", "settings": { "heading": "Quality checked", "subtext": "Inspected before dispatch" } },
        { "type": "trust_item", "settings": { "heading": "Support", "subtext": "Here when you need us" } }
      ]
    }
  ]
}
{% endschema %}
