{{ 'cellife-journeys.css' | asset_url | stylesheet_tag }}
<section class="cellife-journeys cellife-landing-intro" aria-labelledby="Landing-{{ section.id }}">
  <p class="cellife-journeys__eyebrow">{{ section.settings.eyebrow | escape }}</p>
  <h1 id="Landing-{{ section.id }}">{{ section.settings.heading | default: page.title | escape }}</h1>
  <div class="rte">{{ section.settings.text }}</div>
  {% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1800', sizes: '100vw', loading: 'eager' }}{% endif %}
</section>

{% schema %}
{
  "name": "Cellife landing intro",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "EXPLORE CELLIFE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Optional introductory image"
    }
  ],
  "presets": [
    {
      "name": "Cellife landing intro"
    }
  ]
}
{% endschema %}
