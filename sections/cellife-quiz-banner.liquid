{%- capture quiz_url -%}{%- render 'cellife-quiz-url' -%}{%- endcapture -%}
<section id="cellife-quiz-placeholder" class="cellife-photo-banner" aria-labelledby="QuizBanner-{{ section.id }}">
  <div class="cellife-photo-banner__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '600, 900, 1200, 1800, 2400', sizes: '100vw', loading: 'lazy' }}
    {% else %}{% render 'cellife-media-placeholder', label: section.settings.placeholder_label %}{% endif %}
  </div>
  <div class="cellife-photo-banner__copy">
    <p class="cellife-kicker">{{ section.settings.eyebrow | escape }}</p>
    <h2 id="QuizBanner-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    <div class="rte">{{ section.settings.text }}</div>
    <div class="cellife-actions"><a class="cellife-editorial-button" href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">{{ section.settings.shop_label | escape }}</a><a class="cellife-editorial-button cellife-editorial-button--outline" href="{{ quiz_url | escape }}">{{ section.settings.quiz_label | escape }}</a></div>
    {% if settings.cellife_quiz_url == blank %}<p class="cellife-draft-label">{{ section.settings.pending_label | escape }}</p>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Cellife quiz / shop",
  "limit": 1,
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Full-width photograph",
      "info": "Recommended: 2400 × 1200px. Keep the subject clear of the left text panel."
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Missing-image label",
      "default": "Campaign photography placeholder"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "YOUR NEXT CHAPTER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A routine that starts with you."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Explore the supplement range, or start with a little guidance.</p>"
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Shop button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Shop destination",
      "default": "/collections/supplements"
    },
    {
      "type": "text",
      "id": "quiz_label",
      "label": "Quiz button label",
      "default": "Take The Quiz"
    },
    {
      "type": "text",
      "id": "pending_label",
      "label": "Unconnected quiz label",
      "default": "Quiz setup pending — connect the recommendation quiz in Theme settings."
    }
  ],
  "presets": [
    {
      "name": "Cellife quiz / shop"
    }
  ]
}
{% endschema %}
