{{ 'section-cellife-icon-values.css' | asset_url | stylesheet_tag }}
<section class="cellife-icon-values" aria-labelledby="IconValues-{{ section.id }}" style="--icon-row-width: {{ section.settings.row_width }}px; --icon-size: {{ section.settings.icon_size }}px;">
  <div class="cellife-container">
    <div class="cellife-icon-values__intro">
      {% if section.settings.eyebrow != blank %}<p class="cellife-icon-values__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 id="IconValues-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.text != blank %}<div class="cellife-icon-values__text rte">{{ section.settings.text }}</div>{% endif %}
    </div>
    <div class="cellife-icon-values__row">
      {% for block in section.blocks %}
        <div class="cellife-icon-values__item" {{ block.shopify_attributes }}>
          {% if block.settings.top_caption != blank %}<h3>{{ block.settings.top_caption | escape }}</h3>{% endif %}
          <div class="cellife-icon-values__icon">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 320 | image_tag: widths: '112, 160, 224, 320', sizes: '160px', loading: 'lazy' }}
            {% else %}
              <svg viewBox="0 0 120 120" fill="none" aria-hidden="true"><rect x="8" y="8" width="104" height="104" rx="20" stroke="currentColor" stroke-width="2" stroke-dasharray="5 5"/><circle cx="60" cy="60" r="24" stroke="currentColor" stroke-width="2"/><path d="M48 60h24M60 48v24" stroke="currentColor" stroke-width="2"/></svg>
              <span class="visually-hidden">Icon placeholder</span>
            {% endif %}
          </div>
          {% if block.settings.bottom_caption != blank %}<div class="cellife-icon-values__caption rte">{{ block.settings.bottom_caption }}</div>{% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Cellife icon values",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small red title", "default": "THE CELLIFE APPROACH" },
    { "type": "text", "id": "heading", "label": "Blue heading", "default": "A closer look at Cellife." },
    { "type": "richtext", "id": "text", "label": "Supporting text", "default": "<p>Placeholder supporting text. Add approved brand information here.</p>" },
    { "type": "range", "id": "row_width", "label": "Maximum icon row width", "min": 600, "max": 1600, "step": 40, "unit": "px", "default": 1120 },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 48, "max": 160, "step": 8, "unit": "px", "default": 112 }
  ],
  "blocks": [
    {
      "type": "icon",
      "name": "Icon and captions",
      "settings": [
        { "type": "text", "id": "top_caption", "label": "Top caption", "default": "Title placeholder" },
        { "type": "image_picker", "id": "image", "label": "Icon", "info": "Use a square image, ideally a transparent PNG. The full icon is shown without cropping." },
        { "type": "richtext", "id": "bottom_caption", "label": "Bottom caption", "default": "<p>Caption placeholder</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Cellife icon values", "blocks": [{ "type": "icon" }, { "type": "icon" }, { "type": "icon" }, { "type": "icon" }] }]
}
{% endschema %}
