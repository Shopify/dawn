<section class="cellife-section cellife-tone--{{ section.settings.tone }}" aria-labelledby="Editorial-{{ section.id }}">
  <div class="cellife-container cellife-editorial cellife-editorial--{{ section.settings.image_position }}">
    <div class="cellife-editorial__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '400, 600, 900, 1200, 1600', sizes: '(min-width: 750px) 48vw, 100vw', loading: 'lazy' }}
      {% else %}{% render 'cellife-media-placeholder', label: section.settings.placeholder_label %}{% endif %}
    </div>
    <div class="cellife-editorial__copy">
      {% if section.settings.draft %}<p class="cellife-draft-label">{{ section.settings.draft_label | escape }}</p>{% endif %}
      <div class="cellife-section-heading">
  {% if section.settings.eyebrow != blank %}<p class="cellife-kicker">{{ section.settings.eyebrow | escape }}</p>{% endif %}
  <h2 id="Editorial-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
</div>
      {% for block in section.blocks %}<div class="cellife-editorial__point" {{ block.shopify_attributes }}><span aria-hidden="true">{{ forloop.index | prepend: '0' }}</span><div><h3>{{ block.settings.heading | escape }}</h3><div class="rte">{{ block.settings.text }}</div></div></div>{% endfor %}
      {% if section.settings.link != blank and section.settings.label != blank %}<a class="cellife-editorial-button" href="{{ section.settings.link }}">{{ section.settings.label | escape }} <span aria-hidden="true">&rarr;</span></a>{% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cellife editorial story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        {
          "value": "light",
          "label": "White"
        },
        {
          "value": "soft",
          "label": "Soft platinum"
        },
        {
          "value": "dark",
          "label": "Brand blue"
        }
      ],
      "default": "light"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Missing-image label",
      "default": "Editorial image placeholder"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "draft",
      "label": "Mark story as draft",
      "default": true
    },
    {
      "type": "text",
      "id": "draft_label",
      "label": "Draft label",
      "default": "Editorial placeholder — approved copy required"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button destination"
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "point",
      "name": "Supporting point",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Information placeholder"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cellife editorial story"
    }
  ]
}
{% endschema %}
