<div
  class="signup-banner cs-section"
  style="--cs-bg: {{ section.settings.background }}; --cs-text: {{ section.settings.text_color }}; --cs-pad-top: {{ section.settings.padding_top }}px; --cs-pad-bottom: {{ section.settings.padding_bottom }}px; --cs-pad-top-mobile: {{ section.settings.padding_top | times: 0.75 | round }}px; --cs-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.75 | round }}px;"
>
  <div class="cs-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="cs-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="signup-banner__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- assign form_id = 'SignupBanner-' | append: section.id -%}
    {%- form 'customer', id: form_id, class: 'signup-banner__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="signup-banner__message" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="signup-banner__fields">
          <label class="visually-hidden" for="SignupBannerEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
          <input
            id="SignupBannerEmail-{{ section.id }}"
            class="signup-banner__input"
            type="email"
            name="contact[email]"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            required
            placeholder="{{ 'newsletter.label' | t }}"
            {% if form.errors %}
              aria-invalid="true" aria-describedby="SignupBannerError-{{ section.id }}"
            {% endif %}
          >
          <button type="submit" class="cs-pill cs-pill--solid">{{ section.settings.button_label | escape }}</button>
        </div>
        {%- if form.errors -%}
          <p id="SignupBannerError-{{ section.id }}" class="signup-banner__message" role="alert">
            {{ form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email }}
          </p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Signup banner",
  "tag": "section",
  "class": "section section-signup-banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Would you like 10% off?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Also be the first to know about new drops and rewards. Opt-in for updates via email.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Yes, Sign Me Up"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FECAD6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Signup banner"
    }
  ]
}
{% endschema %}
