{%- comment -%} DOUCE: page hero with large headline beside a portrait image (About). {%- endcomment -%}
<section
  class="dc-section color-{{ section.settings.color_scheme }}{% if section.settings.accent_italic %} dc-accent-italic{% endif %}"
  style="--dc-pt: {{ section.settings.padding_top }}px; --dc-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="dc-container">
    <div class="dc-split-hero{% if section.settings.image_position == 'left' %} dc-split-hero--reverse{% endif %}">
      <div class="dc-split-hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="dc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="dc-heading">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="dc-text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- render 'douce-button',
          label: section.settings.button_label,
          link: section.settings.button_link,
          style: section.settings.button_style
        -%}
      </div>
      <div class="dc-media dc-split-hero__media">
        {%- render 'douce-image',
          image: section.settings.image,
          sizes: '(min-width: 750px) 45vw, 100vw',
          eager: true,
          placeholder: 'lifestyle-1'
        -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DOUCE split hero",
  "tag": "div",
  "class": "section-douce-split-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About DOUCE" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Douce, <em>adj.</em> soft, gentle." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We believe the most important step in your routine is the one you never think about: the water.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "info": "Leave empty to hide." },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Color scheme button" },
        { "value": "light", "label": "White" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "primary"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" },
    { "type": "checkbox", "id": "accent_italic", "label": "Accent colour on italic words", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 }
  ],
  "presets": [
    {
      "name": "DOUCE split hero"
    }
  ]
}
{% endschema %}
