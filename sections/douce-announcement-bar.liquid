{%- comment -%} DOUCE: inline announcement bar (all messages in one row on desktop, first message on mobile). {%- endcomment -%}
<div class="dc-announcement color-{{ section.settings.color_scheme }}" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
  {%- if section.blocks.size > 0 -%}
    <ul class="dc-announcement__list" role="list">
      {%- for block in section.blocks -%}
        <li class="dc-announcement__item" data-sep="{{ section.settings.separator | escape }}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            <span>{{ block.settings.text }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "DOUCE announcement bar",
  "class": "section-douce-announcement",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "separator",
      "label": "Separator",
      "default": "·"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Free US delivery"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DOUCE announcement bar",
      "blocks": [
        { "type": "announcement", "settings": { "text": "Free US delivery" } },
        { "type": "announcement", "settings": { "text": "60-day money-back guarantee" } },
        { "type": "announcement", "settings": { "text": "Subscribe & save $10 on your showerhead" } }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
