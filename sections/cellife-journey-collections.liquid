{{ 'cellife-journeys.css' | asset_url | stylesheet_tag }}
<section class="cellife-journeys" aria-labelledby="Collections-{{ section.id }}">
  <div class="cellife-journeys__intro"><h2 id="Collections-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
  <div class="cellife-journeys__grid">
    {% for block in section.blocks %}
      {% assign collection = block.settings.collection %}
      {% if collection != blank %}
        {% assign card_heading = block.settings.heading | default: collection.title %}
        {% assign card_image = block.settings.image | default: collection.image %}
        <div {{ block.shopify_attributes }}>{% render 'cellife-journey-card', image: card_image, number: forloop.index, heading: card_heading, text: block.settings.text, url: collection.url, label: block.settings.label %}</div>
      {% elsif request.design_mode %}
        <p {{ block.shopify_attributes }}>Select an existing collection for this card.</p>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Cellife collection cards",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "collection",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Existing collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Optional image override"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Optional heading override"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Link label",
          "default": "Explore range"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cellife collection cards",
      "blocks": [
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
