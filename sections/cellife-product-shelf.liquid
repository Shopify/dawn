{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
<section class="cellife-section cellife-tone--{{ section.settings.tone }}" aria-labelledby="Editorial-{{ section.id }}">
  <div class="cellife-container"><div class="cellife-section-heading">
  {% if section.settings.eyebrow != blank %}<p class="cellife-kicker">{{ section.settings.eyebrow | escape }}</p>{% endif %}
  <h2 id="Editorial-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
</div>
    <ul class="cellife-product-shelf" role="list">
      {% for shelf_product in section.settings.collection.products limit: section.settings.limit %}
        <li>{% render 'cellife-product-badges', badge_product: shelf_product, bestseller_tag: section.settings.bestseller_tag, new_tag: section.settings.new_tag %}{% render 'card-product', card_product: shelf_product, media_aspect_ratio: 'square', show_secondary_image: true, show_vendor: false, show_rating: false, quick_add: 'none', section_id: section.id %}<a class="cellife-editorial-link" href="{{ shelf_product.url }}">{{ section.settings.product_label | escape }} <span aria-hidden="true">&rarr;</span></a></li>
      {% else %}
        {% for i in (1..4) %}<li class="cellife-shelf-placeholder">{% render 'cellife-media-placeholder', label: section.settings.empty_label %}<p>{{ section.settings.empty_label | escape }}</p></li>{% endfor %}
      {% endfor %}
    </ul>
    {% if section.settings.collection != blank and section.settings.label != blank %}<div class="cellife-section-action"><a class="cellife-editorial-button cellife-editorial-button--outline" href="{{ section.settings.collection.url }}">{{ section.settings.label | escape }} <span aria-hidden="true">&rarr;</span></a></div>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Cellife product shelf",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        {
          "value": "light",
          "label": "White"
        },
        {
          "value": "soft",
          "label": "Soft platinum"
        },
        {
          "value": "dark",
          "label": "Brand blue"
        }
      ],
      "default": "light"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Product count",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "product_label",
      "label": "Product link label",
      "default": "View product"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Collection link label",
      "default": "Explore the range"
    },
    {
      "type": "text",
      "id": "empty_label",
      "label": "Empty collection label",
      "default": "Product placeholder — select a collection"
    },
    {
      "type": "text",
      "id": "bestseller_tag",
      "label": "Bestseller product tag",
      "default": "BESTSELLER"
    },
    {
      "type": "text",
      "id": "new_tag",
      "label": "New product tag",
      "default": "NEW"
    }
  ],
  "presets": [
    {
      "name": "Cellife product shelf"
    }
  ]
}
{% endschema %}
