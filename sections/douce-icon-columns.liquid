{%- comment -%} DOUCE: benefit columns with round icons inside a soft rounded panel. {%- endcomment -%}
<section
  class="dc-section dc-section--transparent"
  style="--dc-pt: {{ section.settings.padding_top }}px; --dc-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="dc-container">
    {%- if section.settings.heading != blank -%}
      <div class="dc-center-head">
        <h2 class="dc-heading dc-heading--s">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <ul class="dc-iconcols color-{{ section.settings.color_scheme }}" role="list" style="--dc-cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <li class="dc-iconcol" {{ block.shopify_attributes }}>
          <span class="dc-iconcol__icon">
            {%- if block.settings.custom_icon != blank -%}
              {{ block.settings.custom_icon | image_url: width: 104 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              {%- render 'douce-icon', name: block.settings.icon -%}
            {%- endif -%}
          </span>
          {%- if block.settings.title != blank -%}
            <h3 class="dc-title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="dc-text">{{ block.settings.text }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "DOUCE benefits panel",
  "tag": "div",
  "class": "section-douce-icon-columns",
  "max_blocks": 8,
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Optional." },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Panel color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "plant", "label": "Plant" },
            { "value": "recycle", "label": "Recycle" },
            { "value": "checkmark", "label": "Check" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "lock", "label": "Lock" },
            { "value": "box", "label": "Box" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" },
            { "value": "snowflake", "label": "Snowflake" },
            { "value": "stopwatch", "label": "Stopwatch" }
          ],
          "default": "leaf"
        },
        { "type": "image_picker", "id": "custom_icon", "label": "Custom icon", "info": "Replaces the icon above." },
        { "type": "text", "id": "title", "label": "Title", "default": "Kinder to skin" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Less chlorine means less dryness and tightness after you shower.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DOUCE benefits panel",
      "blocks": [
        { "type": "column", "settings": { "icon": "leaf", "title": "Kinder to skin", "text": "<p>Less chlorine means less dryness and tightness after you shower.</p>" } },
        { "type": "column", "settings": { "icon": "plant", "title": "Softer-feeling hair", "text": "<p>Hair keeps more of its natural oils and rinses cleaner.</p>" } },
        { "type": "column", "settings": { "icon": "recycle", "title": "See when to swap", "text": "<p>The clear handle shows the filter darken as it works.</p>" } },
        { "type": "column", "settings": { "icon": "checkmark", "title": "Two-minute install", "text": "<p>Twist on to any standard ½\" hose. No tools, no plumber.</p>" } }
      ]
    }
  ]
}
{% endschema %}
