{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}
{{ 'section-cellife-pages.css' | asset_url | stylesheet_tag }}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width cellife-contact">
    <div class="contact">
      <h1 class="h1">{{ section.settings.heading | escape }}</h1>
      <div class="rte">{{ section.settings.text }}</div>
      {% assign contact_form_id = 'ContactForm-' | append: section.id %}
      {% render 'cellife-contact-form', contact_form_id: contact_form_id %}
    </div>
    <aside class="cellife-contact__details rte" aria-label="Contact details">{{ section.settings.details }}</aside>
  </div>
</div>
{% schema %}
{
  "name": "Cellife contact",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction"
    },
    {
      "type": "liquid",
      "id": "details",
      "label": "Contact details (HTML)"
    }
  ],
  "presets": [
    {
      "name": "Cellife contact"
    }
  ]
}
{% endschema %}
