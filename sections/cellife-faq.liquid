<section class="cellife-section cellife-tone--{{ section.settings.tone }}" aria-labelledby="Editorial-{{ section.id }}">
  <div class="cellife-container cellife-faq-layout"><div class="cellife-section-heading">
  {% if section.settings.eyebrow != blank %}<p class="cellife-kicker">{{ section.settings.eyebrow | escape }}</p>{% endif %}
  <h2 id="Editorial-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
</div>
    <div class="cellife-faq-list">
      {% for block in section.blocks %}
        <details class="cellife-faq-item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }}</summary>
          <div class="rte">{% if block.settings.draft %}<p class="cellife-draft-label">{{ section.settings.draft_label | escape }}</p>{% endif %}{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
      {% if section.settings.link != blank and section.settings.label != blank %}<a class="cellife-editorial-link" href="{{ section.settings.link }}">{{ section.settings.label | escape }}</a>{% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cellife questions",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        {
          "value": "light",
          "label": "White"
        },
        {
          "value": "soft",
          "label": "Soft platinum"
        },
        {
          "value": "dark",
          "label": "Brand blue"
        }
      ],
      "default": "light"
    },
    {
      "type": "text",
      "id": "draft_label",
      "label": "Draft label",
      "default": "Answer placeholder — approval required"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Contact link label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Contact link"
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question placeholder"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Add an approved answer here.</p>"
        },
        {
          "type": "checkbox",
          "id": "draft",
          "label": "Mark answer as draft",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cellife questions",
      "blocks": [
        {
          "type": "question"
        },
        {
          "type": "question"
        },
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}
