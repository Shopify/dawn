{%- comment -%} DOUCE: sticky heading beside long-form story text. {%- endcomment -%}
<section
  class="dc-section color-{{ section.settings.color_scheme }}{% if section.settings.accent_italic %} dc-accent-italic{% endif %}"
  style="--dc-pt: {{ section.settings.padding_top }}px; --dc-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="dc-container dc-container--narrow">
    <div class="dc-story">
      {%- if section.settings.heading != blank -%}
        <h2 class="dc-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="dc-story__body">
        {%- if section.settings.lead != blank -%}
          <div class="dc-story__lead">{{ section.settings.lead }}</div>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="dc-stack" style="--dc-stack-gap: 22px;">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.note != blank -%}
          <p class="dc-note" style="font-size: 14px;">{{ section.settings.note | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DOUCE story",
  "tag": "div",
  "class": "section-douce-story",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Better skincare <em>started in the shower.</em>" },
    {
      "type": "richtext",
      "id": "lead",
      "label": "Opening paragraph",
      "default": "<p>Our founder had tried every cream for skin that felt tight after every shower. Nothing lasted past lunch.</p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Story",
      "default": "<p>The change came from somewhere less obvious: the water. After moving to a hard-water city, a simple filter on the showerhead made more difference than the bathroom shelf of products.</p><p>Most filters on the market were bulky, hid the cartridge, or looked like hardware. So we designed one we'd want on display, with a clear handle that shows you the filter working.</p>"
    },
    { "type": "text", "id": "note", "label": "Small print", "info": "Optional." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "accent_italic", "label": "Accent colour on italic words", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [
    {
      "name": "DOUCE story"
    }
  ]
}
{% endschema %}
