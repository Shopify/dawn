{%- comment -%} DOUCE: FAQ with heading on the left and accordion on the right. {%- endcomment -%}
<section
  class="dc-section color-{{ section.settings.color_scheme }}{% if section.settings.accent_italic %} dc-accent-italic{% endif %}"
  style="--dc-pt: {{ section.settings.padding_top }}px; --dc-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="dc-container">
    <div class="dc-faq">
      <div class="dc-faq__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="dc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="dc-heading dc-heading--m">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="dc-text dc-text--s">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- render 'douce-button',
          label: section.settings.button_label,
          link: section.settings.button_link,
          style: 'secondary',
          size: 'm'
        -%}
      </div>
      <div class="dc-accordion">
        {%- for block in section.blocks -%}
          <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
            <summary>
              <span>{{ block.settings.question | escape }}</span>
              <span class="dc-accordion__caret" aria-hidden="true">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
            </summary>
            <div class="dc-accordion__body rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DOUCE FAQ",
  "tag": "div",
  "class": "section-douce-faq",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Questions, <em>answered.</em>" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "info": "For example a link to your contact page. Leave empty to hide." },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "accent_italic", "label": "Accent colour on italic words", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Will it lower my water pressure?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>No. The micro-nozzle face concentrates flow, so most people find pressure feels the same or stronger.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DOUCE FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "Will it lower my water pressure?", "answer": "<p>No. The micro-nozzle face concentrates flow, so most people find pressure feels the same or stronger.</p>" } },
        { "type": "question", "settings": { "question": "How often do I change the filters?", "answer": "<p>Roughly every two months, or sooner if the PP filter darkens noticeably. A 3-pack lasts about six months.</p>" } },
        { "type": "question", "settings": { "question": "Will it fit my shower?", "answer": "<p>DOUCE fits any standard ½\" shower hose. No tools or plumber needed. No hose? Add ours for $24.</p>" } },
        { "type": "question", "settings": { "question": "Does it soften water?", "answer": "<p>It reduces chlorine and catches sediment and some minerals. It is not a whole-home softener, but it is kinder to skin and hair than unfiltered water.</p>" } }
      ]
    }
  ]
}
{% endschema %}
