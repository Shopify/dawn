<div
  class="reviews-highlight cs-section"
  style="--cs-bg: {{ section.settings.background }}; --cs-text: {{ section.settings.text_color }}; --cs-star: {{ section.settings.star_color }}; --cs-pad-top: {{ section.settings.padding_top }}px; --cs-pad-bottom: {{ section.settings.padding_bottom }}px; --cs-pad-top-mobile: {{ section.settings.padding_top | times: 0.75 | round }}px; --cs-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.75 | round }}px;"
>
  <div class="cs-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="cs-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="reviews-highlight__avatars">
        {%- for block in section.blocks -%}
          <div class="reviews-highlight__avatar cs-media" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 160
                | image_tag: loading: 'lazy', widths: '80, 160', sizes: '68px'
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.quote != blank -%}
      <p class="reviews-highlight__quote">{{ section.settings.quote | escape }}</p>
    {%- endif -%}

    {%- if section.settings.rating_text != blank -%}
      <div class="reviews-highlight__rating">
        <span class="cs-stars" aria-hidden="true">
          {%- for i in (1..5) -%}
            {% render 'cs-icon', icon: 'star' %}
          {%- endfor -%}
        </span>
        <span>{{ section.settings.rating_text | escape }}</span>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Reviews highlight",
  "tag": "section",
  "class": "section section-reviews-highlight",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Over 50,000 5★ Reviews"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "Their cases are incredibly protective without sacrificing style, which is a rare combination to find."
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "4.8/5 based on over 100,000+ reviews"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#F2F2F2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#F6C131"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "avatar",
      "name": "Customer photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews highlight",
      "blocks": [
        { "type": "avatar" },
        { "type": "avatar" },
        { "type": "avatar" },
        { "type": "avatar" },
        { "type": "avatar" }
      ]
    }
  ]
}
{% endschema %}
