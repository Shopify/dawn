<section class="cellife-section cellife-tone--soft cellife-first-offer" aria-labelledby="FirstOffer-{{ section.id }}">
  <div class="cellife-container cellife-first-offer__layout">
    <div><p class="cellife-kicker">{{ section.settings.eyebrow | escape }}</p><h2 id="FirstOffer-{{ section.id }}">{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.text }}</div></div>
    <div class="cellife-first-offer__form">
      {% if section.settings.offer_ready and section.settings.discount_code != blank %}
        {% assign form_id = 'CellifeFirstOffer-' | append: section.id %}
        {% form 'customer', id: form_id %}
          <input type="hidden" name="contact[tags]" value="newsletter,cellife-first-order">
          {% if form.posted_successfully? %}
            <div role="status"><p>{{ section.settings.success_text | escape }}</p><strong class="cellife-offer-code">{{ section.settings.discount_code | escape }}</strong><p>{{ section.settings.eligibility_text | escape }}</p></div>
          {% else %}
            {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
            <label for="FirstOfferEmail-{{ section.id }}">{{ section.settings.email_label | escape }}</label>
            <div class="cellife-email-row"><input id="FirstOfferEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email | escape }}"><button type="submit" class="cellife-editorial-button">{{ section.settings.button_label | escape }}</button></div>
            <p class="cellife-first-offer__fineprint">{{ section.settings.consent_text | escape }} {% if shop.privacy_policy.url != blank %}<a href="{{ shop.privacy_policy.url }}">{{ section.settings.privacy_label | escape }}</a>{% endif %}</p>
          {% endif %}
        {% endform %}
      {% else %}
        <p class="cellife-draft-label">{{ section.settings.pending_text | escape }}</p>
        <fieldset disabled><label for="FirstOfferDraft-{{ section.id }}">{{ section.settings.email_label | escape }}</label><div class="cellife-email-row"><input id="FirstOfferDraft-{{ section.id }}" type="email" placeholder="{{ section.settings.email_label | escape }}"><button type="button" class="cellife-editorial-button">{{ section.settings.button_label | escape }}</button></div></fieldset>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cellife first-order offer",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A LITTLE WELCOME"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "10% off your first order."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Sign up for Cellife news and a first-order welcome offer.</p>"
    },
    {
      "type": "checkbox",
      "id": "offer_ready",
      "label": "Shopify discount configured and tested",
      "info": "Create the real 10% discount and enforce first-order eligibility in Shopify before enabling. The form stays disabled until this is on and a code is provided.",
      "default": false
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Configured Shopify discount code"
    },
    {
      "type": "text",
      "id": "pending_text",
      "label": "Setup-pending message",
      "default": "Offer preview — not active yet. Configure the eligible-customer discount in Shopify before enabling signup."
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit label",
      "default": "Get 10% Off"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Signup success message",
      "default": "Thanks for subscribing. Your welcome code is:"
    },
    {
      "type": "text",
      "id": "eligibility_text",
      "label": "Eligibility explanation",
      "default": "Valid for eligible first orders only. Shopify checks eligibility and offer terms at checkout."
    },
    {
      "type": "text",
      "id": "consent_text",
      "label": "Signup consent text",
      "default": "By subscribing, you agree to receive Cellife marketing emails. You can unsubscribe at any time."
    },
    {
      "type": "text",
      "id": "privacy_label",
      "label": "Privacy link label",
      "default": "Privacy policy"
    }
  ],
  "presets": [
    {
      "name": "Cellife first-order offer"
    }
  ]
}
{% endschema %}
