<div
  class="community cs-section"
  style="--cs-bg: {{ section.settings.background }}; --cs-text: {{ section.settings.text_color }}; --cs-pad-top: {{ section.settings.padding_top }}px; --cs-pad-bottom: {{ section.settings.padding_bottom }}px; --cs-pad-top-mobile: {{ section.settings.padding_top | times: 0.75 | round }}px; --cs-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.75 | round }}px;"
>
  <div class="cs-container">
    <div class="cs-header-row">
      {%- if section.settings.heading != blank -%}
        <h2 class="cs-heading community__title">
          {%- if section.settings.show_instagram_icon -%}
            {% render 'cs-icon', icon: 'instagram' %}
          {%- endif -%}
          {%- if section.settings.heading_link != blank -%}
            <a href="{{ section.settings.heading_link }}" class="cs-link-reset">{{ section.settings.heading | escape }}</a>
          {%- else -%}
            {{ section.settings.heading | escape }}
          {%- endif -%}
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="cs-subheading">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>

    <cs-scroller id="Scroller-{{ section.id }}" class="cs-scroller">
      <ul class="cs-scroller__track" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <a
              {% if block.settings.link != blank %}
                href="{{ block.settings.link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="community__card cs-link-reset"
            >
              <span class="cs-media">
                {%- if block.settings.video != blank -%}
                  {{
                    block.settings.video
                    | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '700x'
                  }}
                {%- elsif block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 700
                    | image_tag: loading: 'lazy', widths: '350, 520, 700', sizes: '(min-width: 750px) 346px, 260px'
                  }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </cs-scroller>
  </div>
</div>

{% schema %}
{
  "name": "Community gallery",
  "tag": "section",
  "class": "section section-community-gallery",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Community"
    },
    {
      "type": "url",
      "id": "heading_link",
      "label": "Heading link",
      "info": "For example your Instagram profile"
    },
    {
      "type": "checkbox",
      "id": "show_instagram_icon",
      "label": "Show Instagram icon",
      "default": true
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Join our global collective of creators and bold individuals</p>"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Portrait, around 700 × 1200 px"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Optional. Plays muted and looped in place of the image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Community gallery",
      "blocks": [{ "type": "post" }, { "type": "post" }, { "type": "post" }]
    }
  ]
}
{% endschema %}
