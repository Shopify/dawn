{{ 'cellife-journeys.css' | asset_url | stylesheet_tag }}
{%- capture supplements_url -%}{%- render 'cellife-journey-url', journey: 'supplements' -%}{%- endcapture -%}
{%- capture diagnostics_url -%}{%- render 'cellife-journey-url', journey: 'diagnostics' -%}{%- endcapture -%}
<nav class="cellife-journey-nav" aria-label="{{ section.settings.label | escape }}">
  <a href="{{ supplements_url | escape }}" data-cellife-choice="supplements"{% if request.path == supplements_url %} aria-current="page"{% endif %}>{{ section.settings.supplements_label | escape }}</a>
  <a href="{{ diagnostics_url | escape }}" data-cellife-choice="diagnostics"{% if request.path == diagnostics_url %} aria-current="page"{% endif %}>{{ section.settings.diagnostics_label | escape }}</a>
</nav>

{% schema %}
{
  "name": "Cellife journey navigation",
  "limit": 1,
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Navigation label",
      "default": "Shopping pathways"
    },
    {
      "type": "text",
      "id": "supplements_label",
      "label": "Supplements label",
      "default": "Supplements"
    },
    {
      "type": "text",
      "id": "diagnostics_label",
      "label": "Diagnostics label",
      "default": "Diagnostic Test Kits"
    }
  ],
  "presets": [
    {
      "name": "Cellife journey navigation"
    }
  ]
}
{% endschema %}
