{%- comment -%} DOUCE: "As featured in" press logo row. {%- endcomment -%}
<section
  class="dc-section color-{{ section.settings.color_scheme }}"
  style="--dc-pt: {{ section.settings.padding_top }}px; --dc-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="dc-container">
    <div class="dc-logos">
      {%- if section.settings.label != blank -%}
        <p class="dc-logos__label">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      <ul class="dc-logos__list" role="list" style="--dc-cols: {{ section.blocks.size | at_least: 1 }};">
        {%- for block in section.blocks -%}
          <li class="dc-logos__item" {{ block.shopify_attributes }}>
            {%- capture logo -%}
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.name, sizes: '200px', widths: '200, 400' }}
              {%- else -%}
                <span>{{ block.settings.name | escape }}</span>
              {%- endif -%}
            {%- endcapture -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" target="_blank" rel="noopener">{{ logo }}</a>
            {%- else -%}
              {{ logo }}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DOUCE logo bar",
  "tag": "div",
  "class": "section-douce-logo-bar",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "As featured in" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo image" },
        { "type": "text", "id": "name", "label": "Publication name", "info": "Used as alt text, and shown when there is no logo image.", "default": "Publication" },
        { "type": "url", "id": "link", "label": "Link to article" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DOUCE logo bar",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
