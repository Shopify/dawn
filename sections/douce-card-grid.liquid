{%- comment -%} DOUCE: grid of soft text cards ("What you'll notice" timeline, brand values). {%- endcomment -%}
{%- liquid
  assign has_head = false
  if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank
    assign has_head = true
  endif
-%}
<section
  class="dc-section color-{{ section.settings.color_scheme }}{% if section.settings.accent_italic %} dc-accent-italic{% endif %}"
  style="--dc-pt: {{ section.settings.padding_top }}px; --dc-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="dc-container">
    {%- if has_head -%}
      <div class="{% if section.settings.heading_alignment == 'center' %}dc-center-head{% else %}dc-split-head{% endif %}">
        <div class="dc-stack" style="--dc-stack-gap: 16px;">
          {%- if section.settings.eyebrow != blank -%}
            <p class="dc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="dc-heading dc-heading--l">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
        {%- if section.settings.text != blank -%}
          <div class="dc-text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul
      class="dc-cards dc-cards--{{ section.settings.card_style }}{% if section.settings.card_size == 'large' %} dc-cards--large{% endif %}{% if section.settings.mobile_rail %} dc-rail{% endif %}"
      role="list"
      style="--dc-cols: {{ section.settings.columns }};"
    >
      {%- for block in section.blocks -%}
        <li class="dc-card" {{ block.shopify_attributes }}>
          {%- if block.settings.label != blank -%}
            {%- if section.settings.label_style == 'number' -%}
              <span class="dc-card__num">{{ block.settings.label | escape }}</span>
            {%- else -%}
              <span class="dc-pill">{{ block.settings.label | escape }}</span>
            {%- endif -%}
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="dc-title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="dc-text">{{ block.settings.text }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "DOUCE card grid",
  "tag": "div",
  "class": "section-douce-card-grid",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What you'll notice" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The first two weeks <em>with DOUCE.</em>" },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading layout",
      "options": [
        { "value": "center", "label": "Centered" },
        { "value": "split", "label": "Heading left, text right" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "mint", "label": "Mint" },
        { "value": "white", "label": "White" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "mint"
    },
    {
      "type": "select",
      "id": "card_size",
      "label": "Card size",
      "options": [
        { "value": "regular", "label": "Regular" },
        { "value": "large", "label": "Large" }
      ],
      "default": "regular"
    },
    {
      "type": "select",
      "id": "label_style",
      "label": "Label style",
      "options": [
        { "value": "pill", "label": "Pill" },
        { "value": "number", "label": "Serif number" }
      ],
      "default": "pill"
    },
    { "type": "checkbox", "id": "mobile_rail", "label": "Swipe cards on mobile", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "accent_italic", "label": "Accent colour on italic words", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Day 1" },
        { "type": "text", "id": "title", "label": "Title", "default": "A softer rinse" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Water feels lighter on skin. Less of that chlorine smell in the steam.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DOUCE card grid",
      "blocks": [
        { "type": "card", "settings": { "label": "Day 1", "title": "A softer rinse", "text": "<p>Water feels lighter on skin. Less of that chlorine smell in the steam.</p>" } },
        { "type": "card", "settings": { "label": "Day 3", "title": "Less tightness", "text": "<p>Skin feels less tight after you step out, so you reach for less lotion.</p>" } },
        { "type": "card", "settings": { "label": "Week 1", "title": "Hair rinses cleaner", "text": "<p>Less build-up means shampoo rinses out fully and hair feels lighter.</p>" } },
        { "type": "card", "settings": { "label": "Week 2", "title": "You see the filter", "text": "<p>The PP filter starts to darken. That is what stayed out of your shower.</p>" } }
      ]
    }
  ]
}
{% endschema %}
