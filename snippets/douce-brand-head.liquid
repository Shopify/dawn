{% doc %}
  Outputs DOUCE brand tokens (Theme settings > DOUCE brand) and, when enabled,
  the DOUCE web fonts. Rendered in <head> after base.css.

  Fonts are served from the theme's assets by default (Cormorant Garamond and
  Manrope, SIL Open Font License). The Google option loads the font names set
  in the theme settings from Google Fonts instead.
{% enddoc %}

{%- liquid
  assign douce_font_host = settings.douce_font_host | default: 'shopify'
  if douce_font_host == 'google'
    assign douce_display_family = settings.douce_font_display | default: 'Cormorant Garamond'
    assign douce_body_family = settings.douce_font_body | default: 'Manrope'
  else
    assign douce_display_family = 'Cormorant Garamond'
    assign douce_body_family = 'Manrope'
  endif
-%}

{%- if settings.douce_google_fonts -%}
  {%- if douce_font_host == 'google' -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family={{ douce_display_family | url_encode | replace: '%20', '+' }}:ital,wght@0,400;0,500;0,600;1,400;1,500&family={{ douce_body_family | url_encode | replace: '%20', '+' }}:wght@400;500;600;700&display=swap"
    >
  {%- else -%}
    {{ 'douce-cormorant-garamond.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {{ 'douce-manrope.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {%- style -%}
    @font-face {
      font-family: 'Cormorant Garamond';
      font-style: italic;
      font-weight: 400 500;
      font-display: swap;
      src: url({{ 'douce-cormorant-garamond-italic-latin-ext.woff2' | asset_url }}) format('woff2');
      unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;
    }
    @font-face {
      font-family: 'Cormorant Garamond';
      font-style: italic;
      font-weight: 400 500;
      font-display: swap;
      src: url({{ 'douce-cormorant-garamond-italic.woff2' | asset_url }}) format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    @font-face {
      font-family: 'Cormorant Garamond';
      font-style: normal;
      font-weight: 400 600;
      font-display: swap;
      src: url({{ 'douce-cormorant-garamond-latin-ext.woff2' | asset_url }}) format('woff2');
      unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;
    }
    @font-face {
      font-family: 'Cormorant Garamond';
      font-style: normal;
      font-weight: 400 600;
      font-display: swap;
      src: url({{ 'douce-cormorant-garamond.woff2' | asset_url }}) format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    @font-face {
      font-family: 'Manrope';
      font-style: normal;
      font-weight: 400 700;
      font-display: swap;
      src: url({{ 'douce-manrope-latin-ext.woff2' | asset_url }}) format('woff2');
      unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;
    }
    @font-face {
      font-family: 'Manrope';
      font-style: normal;
      font-weight: 400 700;
      font-display: swap;
      src: url({{ 'douce-manrope.woff2' | asset_url }}) format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    {%- endstyle -%}
  {%- endif -%}
{%- endif -%}

{%- style -%}
  :root {
    --douce-pine: {{ settings.douce_color_pine }};
    --douce-pine-rgb: {{ settings.douce_color_pine.red }}, {{ settings.douce_color_pine.green }}, {{ settings.douce_color_pine.blue }};
    --douce-leaf: {{ settings.douce_color_leaf }};
    --douce-leaf-rgb: {{ settings.douce_color_leaf.red }}, {{ settings.douce_color_leaf.green }}, {{ settings.douce_color_leaf.blue }};
    --douce-lime-rgb: {{ settings.douce_color_lime.red }}, {{ settings.douce_color_lime.green }}, {{ settings.douce_color_lime.blue }};
    --douce-mint-rgb: {{ settings.douce_color_mint.red }}, {{ settings.douce_color_mint.green }}, {{ settings.douce_color_mint.blue }};
    --douce-lime: {{ settings.douce_color_lime }};
    --douce-lime-deep: {{ settings.douce_color_lime_deep }};
    --douce-mint: {{ settings.douce_color_mint }};
    --douce-mint-deep: {{ settings.douce_color_mint_deep }};
    --douce-stock: {{ settings.douce_color_stock }};
    --dc-page-width: {{ settings.douce_page_width | default: 1320 }}px;
    --dc-section-gap: {{ settings.douce_section_spacing | default: 120 }}px;
    {%- if settings.douce_google_fonts %}
      --font-display: '{{ douce_display_family }}', Georgia, 'Times New Roman', serif;
      --font-body: '{{ douce_body_family }}', 'Helvetica Neue', Helvetica, Arial, sans-serif;
      --font-heading-family: var(--font-display);
      --font-heading-style: normal;
      --font-heading-weight: 500;
      --font-body-family: var(--font-body);
      --font-body-style: normal;
      --font-body-weight: 400;
      --font-body-weight-bold: 700;
    {%- else %}
      --font-display: var(--font-heading-family);
      --font-body: var(--font-body-family);
    {%- endif %}
  }
{%- endstyle -%}
