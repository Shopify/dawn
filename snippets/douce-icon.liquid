{% doc %}
  Renders one of the theme's SVG icons, tinted with the section accent colour.

  @param {string} name - Icon name without prefix, e.g. 'check-mark', 'truck', 'leaf'.
  @param {number} [size] - Size in px (default 16).
  @param {string} [class] - Extra classes.

  @example
  {% render 'douce-icon', name: 'leaf', size: 22 %}
{% enddoc %}
{%- liquid
  assign icon_name = name | default: 'checkmark'
  if icon_name == 'check-mark' or icon_name == 'check_mark'
    assign icon_name = 'checkmark'
  endif
  assign icon_name = icon_name | replace: '_', '-'
  assign icon_file = 'icon-' | append: icon_name | append: '.svg'
-%}
<span class="dc-icon{% if class %} {{ class }}{% endif %}"{% if size %} style="--dc-icon-size: {{ size }}px;"{% endif %} aria-hidden="true">
  {{- icon_file | inline_asset_content -}}
</span>
