{% comment %}
  Renders an inline SVG icon for the custom homepage sections.
  Accepts:
  - icon: {String} arrow-left, arrow-right, chevron-left, chevron-right, star, instagram,
    trophy, sparkle, truck, return, secure, warranty, heart, leaf, chat, gift
{% endcomment %}
{%- case icon -%}
  {%- when 'arrow-left' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M27 16H5M13 8l-8 8 8 8"/></svg>
  {%- when 'arrow-right' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M5 16h22M19 8l8 8-8 8"/></svg>
  {%- when 'chevron-left' -%}
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M10 3 5 8l5 5"/></svg>
  {%- when 'chevron-right' -%}
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="m6 3 5 5-5 5"/></svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="m10 1.5 2.6 5.5 6 .7-4.4 4.1 1.2 5.9L10 14.8l-5.4 2.9 1.2-5.9L1.4 7.7l6-.7z"/></svg>
  {%- when 'instagram' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
  {%- when 'trophy' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 4h12v8a6 6 0 0 1-12 0zM10 7H5v2a5 5 0 0 0 5 5M22 7h5v2a5 5 0 0 1-5 5M16 18v5M11 28h10l-1-5h-8z"/></svg>
  {%- when 'sparkle' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M16 3c1 6.5 3.5 9 10 10-6.5 1-9 3.5-10 10-1-6.5-3.5-9-10-10 6.5-1 9-3.5 10-10zM26 21c.4 2.3 1.2 3.1 3.5 3.5-2.3.4-3.1 1.2-3.5 3.5-.4-2.3-1.2-3.1-3.5-3.5 2.3-.4 3.1-1.2 3.5-3.5z"/></svg>
  {%- when 'truck' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8h17v14H3zM20 13h5l4 5v4h-9"/><circle cx="9" cy="24" r="2.5" fill="#fff"/><circle cx="24" cy="24" r="2.5" fill="#fff"/></svg>
  {%- when 'return' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 11h22v16H5zM8 5h16l3 6H5zM20 19h-8M15 16l-3 3 3 3"/></svg>
  {%- when 'secure' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="7" width="22" height="15" rx="2"/><path d="M3 12h22M7 17h6"/><path d="M24 17l5 2v4c0 3-2.2 5-5 6-2.8-1-5-3-5-6v-4z" fill="#fff"/></svg>
  {%- when 'warranty' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m16 3 3 2.2 3.7-.1 1.1 3.5 3 2.2-1.2 3.5 1.2 3.5-3 2.2-1.1 3.5-3.7-.1L16 25.6l-3-2.2-3.7.1-1.1-3.5-3-2.2 1.2-3.5-1.2-3.5 3-2.2 1.1-3.5 3.7.1z"/><path d="m12 14 3 3 5-6M11 24l-2 6 4-2 3 2M21 24l2 6-4-2"/></svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M16 3 5 7v8c0 6.5 4.6 11.8 11 14 6.4-2.2 11-7.5 11-14V7z"/><path d="m11 16 3.5 3.5L21.5 12"/></svg>
  {%- when 'bag' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 8h14l-1 13H6zM9 8V6a3 3 0 0 1 6 0v2"/><path d="M15 14h4M17 12v4" stroke-linecap="round"/></svg>
  {%- when 'heart' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M16 27S4 20 4 11.5A6.5 6.5 0 0 1 16 8a6.5 6.5 0 0 1 12 3.5C28 20 16 27 16 27z"/></svg>
  {%- when 'leaf' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 26C6 12 14 5 27 5c0 13-7 21-21 21zM6 26l12-12"/></svg>
  {%- when 'chat' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 6h24v16H13l-6 5v-5H4z"/></svg>
  {%- when 'gift' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 11h24v5H4zM6 16h20v12H6zM16 11v17M16 11c-2-5-8-6-8-2 0 2 4 2 8 2zM16 11c2-5 8-6 8-2 0 2-4 2-8 2z"/></svg>
{%- endcase -%}
