{% doc %}
  Renders a DOUCE pill button. Nothing is output when the label is blank.

  @param {string} label - Button text.
  @param {string} [link] - URL. Without one the button renders disabled.
  @param {string} [style] - primary | dark | light | lime | secondary (default primary).
  @param {string} [size] - l | m | s (default l).
  @param {boolean} [full] - Full width.
  @param {string} [class] - Extra classes.

  @example
  {% render 'douce-button', label: section.settings.button_label, link: section.settings.button_link, style: 'dark' %}
{% enddoc %}
{%- if label != blank -%}
  {%- liquid
    assign btn_style = style | default: 'primary'
    assign btn_size = size | default: 'l'
    capture btn_class
      echo 'dc-btn dc-btn--' | append: btn_style
      if btn_size != 'l'
        echo ' dc-btn--' | append: btn_size
      endif
      if full
        echo ' dc-btn--full'
      endif
      if class
        echo ' ' | append: class
      endif
    endcapture
  -%}
  {%- if link != blank -%}
    <a href="{{ link }}" class="{{ btn_class }}">{{ label | escape }}</a>
  {%- else -%}
    <a role="link" aria-disabled="true" class="{{ btn_class }}">{{ label | escape }}</a>
  {%- endif -%}
{%- endif -%}
