{% doc %}
  DOUCE checklist block for the product info column (up to 6 short benefits).

  @param {object} block - douce_checklist block.
{% enddoc %}
{%- capture items -%}
  {%- for i in (1..6) -%}
    {%- assign key = 'item_' | append: i -%}
    {%- if block.settings[key] != blank -%}
      <li>
        {%- render 'douce-icon', name: block.settings.icon, size: 16 -%}
        <span>{{ block.settings[key] | escape }}</span>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if items != blank -%}
  <ul
    class="dc-checks"
    role="list"
    {% if block.settings.columns == '1' %}
      style="grid-template-columns: minmax(0, 1fr);"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    {{ items }}
  </ul>
{%- endif -%}
