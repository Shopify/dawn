{% comment %}
  Grid size toggle for the bold collection grid. Sets data-grid-view on the
  nearest .collection-bold wrapper (see grid-view-toggle in custom-sections.js).
{% endcomment %}
<grid-view-toggle class="grid-view-toggle" role="group" aria-label="Grid size">
  <button type="button" data-view="large" aria-label="Large grid">
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><rect x="4" y="3" width="12" height="11" rx="1.5"/><path d="M4 17h12"/></svg>
  </button>
  <button type="button" data-view="medium" aria-label="Medium grid">
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><rect x="3" y="3" width="5.5" height="14" rx="1.5"/><rect x="11.5" y="3" width="5.5" height="14" rx="1.5"/></svg>
  </button>
  <button type="button" data-view="small" aria-label="Small grid">
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><rect x="3" y="3" width="5.5" height="5.5" rx="1.2"/><rect x="11.5" y="3" width="5.5" height="5.5" rx="1.2"/><rect x="3" y="11.5" width="5.5" height="5.5" rx="1.2"/><rect x="11.5" y="11.5" width="5.5" height="5.5" rx="1.2"/></svg>
  </button>
</grid-view-toggle>
