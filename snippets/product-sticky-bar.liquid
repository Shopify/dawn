{% comment %}
  Sticky add-to-cart bar for the product page. Submits the main product form and
  mirrors its price and button state (see product-sticky-bar in custom-sections.js).
  Accepts:
  - product: {Object}
  - product_form_id: {String} id of the main product form
  - section_id: {String}
{% endcomment %}
<product-sticky-bar
  class="product-sticky-bar"
  data-form-id="{{ product_form_id }}"
  data-section-id="{{ section_id }}"
  hidden
>
  <div class="product-sticky-bar__inner page-width">
    <div class="product-sticky-bar__info">
      <span class="product-sticky-bar__title">{{ product.title | escape }}</span>
      <span class="product-sticky-bar__price">
        {{- product.selected_or_first_available_variant.price | money_with_currency -}}
      </span>
    </div>
    <button
      type="submit"
      form="{{ product_form_id }}"
      name="add"
      class="product-sticky-bar__button"
      {% unless product.selected_or_first_available_variant.available %}
        disabled
      {% endunless %}
    >
      {%- if product.selected_or_first_available_variant.available -%}
        {{ 'products.product.add_to_cart' | t }}
      {%- else -%}
        {{ 'products.product.sold_out' | t }}
      {%- endif -%}
    </button>
  </div>
</product-sticky-bar>
