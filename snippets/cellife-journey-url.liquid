{%- liquid
  if journey == 'supplements'
    if settings.cellife_supplements_page != blank
      echo settings.cellife_supplements_page.url
    else
      echo routes.root_url | append: '/pages/supplements' | replace: '//', '/'
    endif
  else
    if settings.cellife_diagnostics_page != blank
      echo settings.cellife_diagnostics_page.url
    else
      echo routes.root_url | append: '/pages/diagnostic-test-kits' | replace: '//', '/'
    endif
  endif
-%}
