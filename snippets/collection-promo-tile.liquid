{% comment %}
  Full-width promo tile shown inside the bold collection grid.
  Accepts:
  - settings_source: {Object} section.settings holding the promo_* settings
{% endcomment %}
<li class="grid__item collection-promo">
  <div class="collection-promo__media">
    {%- if settings_source.promo_image != blank -%}
      {{
        settings_source.promo_image
        | image_url: width: 2000
        | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 2000', sizes: '(min-width: 990px) 960px, 100vw'
      }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  {%- if settings_source.promo_heading != blank -%}
    <h2 class="collection-promo__heading">{{ settings_source.promo_heading | escape }}</h2>
  {%- endif -%}
  {%- if settings_source.promo_text != blank -%}
    <p class="collection-promo__text">{{ settings_source.promo_text | escape }}</p>
  {%- endif -%}
  {%- if settings_source.promo_button_label != blank -%}
    <a
      {% if settings_source.promo_link != blank %}
        href="{{ settings_source.promo_link }}"
      {% else %}
        role="link" aria-disabled="true"
      {% endif %}
      class="cs-pill"
    >
      {{- settings_source.promo_button_label | escape -}}
    </a>
  {%- endif -%}
</li>
