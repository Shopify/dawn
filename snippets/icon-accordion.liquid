{%- doc -%}
  Renders an accordion icon from the theme's icon assets.

  @param {string} icon - The icon setting value. Underscores are converted to hyphens to form the asset name; `none` renders nothing.

  @example
  {% render 'icon-accordion', icon: block.settings.icon %}
{%- enddoc -%}
{%- if icon != 'none' -%}
  {%- assign file = icon | replace: '_', '-' | prepend: 'icon-' | append: '.svg' -%}
  <span class="svg-wrapper">{{ file | inline_asset_content }}</span>
{%- endif -%}
