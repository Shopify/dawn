{%- comment -%}
  Картка переваги.

  Параметри:
  - icon  {Image}  іконка (опційно)
  - title {String} заголовок
  - text  {String} опис
{%- endcomment -%}

{%- if icon != blank -%}
  <img
    src="{{ icon | image_url: width: 96 }}"
    alt="{{ icon.alt | escape }}"
    width="48"
    height="48"
    loading="lazy"
  >
{%- endif -%}

{%- if title != blank -%}
  <h3 class="custom-features__title">{{ title }}</h3>
{%- endif -%}

{%- if text != blank -%}
  <p class="custom-features__text">{{ text }}</p>
{%- endif -%}