{%- assign footer_logo = block.settings.logo | default: settings.logo | default: settings.brand_image -%}
<div class="cellife-footer-brand">
  <a class="cellife-footer-brand__logo" href="{{ routes.root_url }}" style="--footer-logo-width: {{ block.settings.logo_width }}px;">
    {% if footer_logo != blank %}
      {%- assign logo_alt = footer_logo.alt | default: shop.name -%}
      {{ footer_logo | image_url: width: 720 | image_tag: widths: '160, 240, 320, 480, 720', sizes: '(min-width: 990px) 240px, 200px', loading: 'lazy', alt: logo_alt }}
    {% else %}<span>{{ shop.name | escape }}</span>{% endif %}
  </a>
  {% if block.settings.text != blank %}<div class="cellife-footer-brand__text rte">{{ block.settings.text }}</div>{% endif %}
  {% if block.settings.tagline != blank %}<p class="cellife-footer-brand__tagline">{{ block.settings.tagline | escape }}</p>{% endif %}
</div>
