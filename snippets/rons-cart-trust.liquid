{% comment %}
  Ron's Pijamas – reassurance line and payment icons under the cart drawer
  checkout button. Driven by Theme settings > Cart drawer extras.

  Usage:
  {% render 'rons-cart-trust' %}
{% endcomment %}

{%- if settings.rons_cart_trust_1 != blank or settings.rons_cart_trust_2 != blank -%}
  <ul class="rons-cart-trust" role="list">
    {%- if settings.rons_cart_trust_1 != blank -%}
      <li>
        <span class="svg-wrapper" aria-hidden="true">{{- 'icon-lock.svg' | inline_asset_content -}}</span>
        {{ settings.rons_cart_trust_1 | escape }}
      </li>
    {%- endif -%}
    {%- if settings.rons_cart_trust_2 != blank -%}
      <li>
        <span class="svg-wrapper" aria-hidden="true">{{- 'icon-return.svg' | inline_asset_content -}}</span>
        {{ settings.rons_cart_trust_2 | escape }}
      </li>
    {%- endif -%}
  </ul>
{%- endif -%}

{%- if settings.rons_cart_payment_icons and shop.enabled_payment_types.size > 0 -%}
  <ul class="rons-cart-payment" role="list">
    {%- for type in shop.enabled_payment_types limit: 6 -%}
      <li>{{ type | payment_type_svg_tag }}</li>
    {%- endfor -%}
  </ul>
{%- endif -%}
