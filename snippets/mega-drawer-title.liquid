{% comment %}
  Renders a menu link title, turning a trailing tag like "Phone Cases [NEW]" into a badge.
  Supported badge colors: NEW, TOP, SALE, HOT (anything else uses the default style).
  Accepts:
  - title: {String} the raw menu link title
{% endcomment %}
{%- liquid
  assign parts = title | split: ' ['
  assign label = parts.first | strip
  assign badge = ''
  if parts.size > 1
    assign badge = parts.last | remove: ']' | strip
  endif
-%}
{{ label | escape }}
{%- if badge != blank -%}
  <span class="mega-drawer__badge mega-drawer__badge--{{ badge | handleize }}">{{ badge | escape }}</span>
{%- endif -%}
