{%- liquid
  assign bestseller_key = bestseller_tag | default: 'BESTSELLER' | strip | downcase
  assign new_key = new_tag | default: 'NEW' | strip | downcase
  assign is_bestseller = false
  assign is_new = false
  for tag in badge_product.tags
    assign normalized_tag = tag | strip | downcase
    if normalized_tag == bestseller_key
      assign is_bestseller = true
    endif
    if normalized_tag == new_key
      assign is_new = true
    endif
  endfor
-%}
{%- if is_bestseller -%}<span class="cellife-product-badge">{{ bestseller_tag | default: 'BESTSELLER' | escape }}</span>
{%- elsif is_new -%}<span class="cellife-product-badge cellife-product-badge--new">{{ new_tag | default: 'NEW' | escape }}</span>{%- endif -%}
