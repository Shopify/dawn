<article class="cellife-journey-card">
  <div class="cellife-journey-card__media">
    {% if image != blank %}
      {{ image | image_url: width: 1200 | image_tag: widths: '400, 600, 900, 1200', sizes: '(min-width: 750px) 45vw, 100vw', loading: 'lazy' }}
    {% else %}
      <div class="cellife-journey-placeholder" aria-hidden="true"><span>{{ number | escape }}</span></div>
    {% endif %}
  </div>
  <div class="cellife-journey-card__copy">
    <h3>{{ heading | escape }}</h3>
    {% if text != blank %}<p>{{ text | escape }}</p>{% endif %}
    {% if url != blank %}<a class="cellife-journey-link" href="{{ url | escape }}"{% if journey != blank %} data-cellife-choice="{{ journey | escape }}"{% endif %}>{{ label | escape }} <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12"/></svg></a>{% endif %}
  </div>
</article>
