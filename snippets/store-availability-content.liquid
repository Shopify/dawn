{% doc %}
  Renders the store availability preview and drawer for a variant. The `pickup-availability` and `store-availability` sections render it when pickup-availability.js fetches them through the Section Rendering API.

  @param {variant} product_variant - The variant to show availability for.
  @param {boolean} show_physical_stores - Whether to also list physical storefronts that have the variant in stock without offering pickup, and note which pickup locations also sell in store.

  @example
  {% render 'store-availability-content', product_variant: product_variant, show_physical_stores: true %}
{% enddoc %}

{%- liquid
  assign listed_count = 0
  assign closest_pickup = null
  assign closest_store = null
  assign pickup_in_stock = false

  for availability in product_variant.store_availabilities
    if availability.pick_up_enabled
      assign listed_count = listed_count | plus: 1
      if closest_pickup == null
        assign closest_pickup = availability
      endif
      if availability.available
        assign pickup_in_stock = true
      endif
    elsif show_physical_stores and availability.physical_storefront and availability.available_without_transfer
      assign listed_count = listed_count | plus: 1
      if closest_store == null
        assign closest_store = availability
      endif
    endif
  endfor

  assign lead_with_store = false
  if closest_store and pickup_in_stock == false
    assign lead_with_store = true
  endif
-%}

{%- if listed_count > 0 -%}
  <pickup-availability-preview class="pickup-availability-preview">
    {%- if lead_with_store -%}
      {%- comment -%} No pickup location has this variant in stock, but a physical store does. {%- endcomment -%}
      <span class="svg-wrapper">{{ 'icon-tick.svg' | inline_asset_content }}</span>

      <div class="pickup-availability-info">
        <p class="caption-large">
          {{ 'products.product.pickup_availability.in_stock_at_html' | t: location_name: closest_store.location.name }}
        </p>
        <p class="caption">{{ 'products.product.pickup_availability.in_store_only' | t }}</p>
        <button
          id="ShowPickupAvailabilityDrawer"
          class="pickup-availability-button link link--text underlined-link"
          aria-haspopup="dialog"
        >
          {%- if listed_count == 1 -%}
            {{ 'products.product.pickup_availability.view_store_info' | t }}
          {%- else -%}
            {{ 'products.product.pickup_availability.check_other_stores' | t }}
          {%- endif -%}
        </button>
      </div>
    {%- elsif closest_pickup.pick_up_enabled -%}
      {% if closest_pickup.available %}
        <span class="svg-wrapper">{{ 'icon-tick.svg' | inline_asset_content }}</span>
      {% endif %}

      <div class="pickup-availability-info">
        {%- if closest_pickup.available -%}
          <p class="caption-large">
            {{
              'products.product.pickup_availability.pick_up_available_at_html'
              | t: location_name: closest_pickup.location.name
            }}
          </p>
          <p class="caption">{{ closest_pickup.pick_up_time }}</p>
          <button
            id="ShowPickupAvailabilityDrawer"
            class="pickup-availability-button link link--text underlined-link"
            aria-haspopup="dialog"
          >
            {%- if listed_count == 1 -%}
              {{ 'products.product.pickup_availability.view_store_info' | t }}
            {%- else -%}
              {{ 'products.product.pickup_availability.check_other_stores' | t }}
            {%- endif -%}
          </button>
        {%- else -%}
          <p class="caption-large">
            {{
              'products.product.pickup_availability.pick_up_unavailable_at_html'
              | t: location_name: closest_pickup.location.name
            }}
          </p>
          {%- if listed_count > 1 -%}
            <button
              id="ShowPickupAvailabilityDrawer"
              class="pickup-availability-button link link--text underlined-link"
              aria-haspopup="dialog"
            >
              {{ 'products.product.pickup_availability.check_other_stores' | t }}
            </button>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </pickup-availability-preview>

  <pickup-availability-drawer
    class="gradient"
    tabindex="-1"
    role="dialog"
    aria-modal="true"
    aria-labelledby="PickupAvailabilityHeading"
  >
    <div class="pickup-availability-header">
      <h2 class="h3 pickup-availability-drawer-title" id="PickupAvailabilityHeading">
        {{ product_variant.product.title | escape }}
      </h2>
      <button class="pickup-availability-drawer-button" type="button" aria-label="{{ 'accessibility.close' | t }}">
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
    </div>

    {%- unless product_variant.product.has_only_default_variant -%}
      <p class="pickup-availability-variant">
        {%- for product_option in product_variant.product.options_with_values -%}
          {{ product_option.name | escape }}:&nbsp;
          {%- for value in product_option.values -%}
            {%- if product_option.selected_value == value -%}
              <span>{{ value | escape }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- unless forloop.last -%},&nbsp;{%- endunless -%}
        {%- endfor -%}
      </p>
    {%- endunless -%}

    <ul class="pickup-availability-list list-unstyled" role="list" data-store-availability-drawer-content>
      {%- for availability in product_variant.store_availabilities -%}
        {%- liquid
          assign is_walk_in_only = false
          if availability.pick_up_enabled == false and show_physical_stores and availability.physical_storefront and availability.available_without_transfer
            assign is_walk_in_only = true
          endif
          unless availability.pick_up_enabled or is_walk_in_only
            continue
          endunless
        -%}
        <li class="pickup-availability-list__item">
          <h3 class="h4">{{ availability.location.name | escape }}</h3>

          {%- if is_walk_in_only -%}
            <p class="pickup-availability-preview caption-large">
              <span class="svg-wrapper">
                {{- 'icon-tick.svg' | inline_asset_content -}}
              </span>
              {{ 'products.product.pickup_availability.in_stock_in_store' | t }}
            </p>
            <p class="caption pickup-availability-in-store">
              {{ 'products.product.pickup_availability.in_store_only' | t }}
            </p>
          {%- elsif availability.pick_up_enabled -%}
            <p class="pickup-availability-preview caption-large">
              {%- if availability.available -%}
                <span class="svg-wrapper">
                  {{- 'icon-tick.svg' | inline_asset_content -}}
                </span>
                {{ 'products.product.pickup_availability.pick_up_available' | t }},
                {{ availability.pick_up_time | downcase }}
              {%- endif -%}
            </p>
            {%- if show_physical_stores and availability.physical_storefront and availability.available_without_transfer -%}
              <p class="caption pickup-availability-in-store">
                {{ 'products.product.pickup_availability.also_sold_in_store' | t }}
              </p>
            {%- endif -%}
          {%- endif -%}

          {%- assign address = availability.location.address -%}
          <address class="pickup-availability-address">
            {{ address | format_address }}

            {%- if address.phone.size > 0 -%}
              <p>{{ address.phone }}</p>
            {%- endif -%}
          </address>
        </li>
      {%- endfor -%}
    </ul>
  </pickup-availability-drawer>
{%- endif -%}
