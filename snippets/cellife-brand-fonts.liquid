{% comment %}Self-hosted brand fonts; shared by storefront, password and gift card layouts.{% endcomment %}
{{ 'inter-latin-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'broadacre-thin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{% style %}
  @font-face { font-family: 'Inter'; src: url('{{ 'inter-latin-normal.woff2' | asset_url }}') format('woff2'); font-weight: 100 900; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Inter'; src: url('{{ 'inter-latin-italic.woff2' | asset_url }}') format('woff2'); font-weight: 100 900; font-style: italic; font-display: swap; }
  @font-face { font-family: 'Broadacre'; src: url('{{ 'broadacre-hairline.woff2' | asset_url }}') format('woff2'); font-weight: 100; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Broadacre'; src: url('{{ 'broadacre-thin.woff2' | asset_url }}') format('woff2'); font-weight: 200; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Broadacre'; src: url('{{ 'broadacre-light.woff2' | asset_url }}') format('woff2'); font-weight: 300; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Broadacre'; src: url('{{ 'broadacre-regular.woff2' | asset_url }}') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Broadacre'; src: url('{{ 'broadacre-medium.woff2' | asset_url }}') format('woff2'); font-weight: 500; font-style: normal; font-display: swap; }
{% endstyle %}
